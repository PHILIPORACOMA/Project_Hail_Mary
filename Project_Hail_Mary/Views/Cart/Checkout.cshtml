@model Project_Hail_Mary.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cartItems = ViewBag.CartItems as List<Project_Hail_Mary.Models.Cart> ?? new();
    decimal subtotal = cartItems.Sum(i => i.Price * i.Quantity);
    decimal shipping = 0;
    decimal taxes = 0;
    decimal total = subtotal + shipping + taxes;
    bool addressSubmitted = ViewBag.AddressSubmitted == true;
}

<style>
    body {
        background: #f8f9fa;
        font-family: 'DM Sans', sans-serif;
    }

    .checkout-overlay {
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 4rem 2rem;
    }

    .checkout-panel {
        background: #fff;
        width: 100%;
        max-width: 900px;
        border-radius: 12px;
        padding: 3rem;
        position: relative;
        box-shadow: 0 20px 60px rgba(0,0,0,0.06);
    }

    .checkout-header {
        text-align: left;
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 2.5rem;
    }

    .checkout-close {
        position: absolute;
        top: 2rem;
        right: 2rem;
        background: #f5f5f5;
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: #666;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .checkout-close:hover {
        background: #1a2f6e;
        color: #fff;
    }

    .checkout-body {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
    }

    @@media (max-width: 768px) {
        .checkout-body {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }

    /* LEFT — Shipping form */
    .section-title {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #1a2f6e;
        margin: 0 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #eee;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-row.full {
        grid-template-columns: 1fr;
    }

    .co-input {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0.9rem 1.2rem;
        font-size: 0.95rem;
        color: #333;
        outline: none;
        box-sizing: border-box;
        transition: all 0.25s;
        background: #fafafa;
    }

    .co-input:focus {
        border-color: #1a2f6e;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(26, 47, 110, 0.08);
    }

    .co-input::placeholder {
        color: #bbb;
    }

    .default-addr-check {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 2rem 0;
        font-size: 0.9rem;
        color: #555;
        cursor: pointer;
    }

    .default-addr-check input {
        width: 20px;
        height: 20px;
        accent-color: #1a2f6e;
        cursor: pointer;
    }

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2.5rem;
    }

    .return-link {
        font-size: 0.9rem;
        color: #888;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        transition: color 0.2s;
    }

    .return-link:hover {
        color: #1a2f6e;
    }

    .submit-btn {
        background: #1a2f6e;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.9rem 2.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(26, 47, 110, 0.15);
    }

    .submit-btn:hover {
        background: #0f2260;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(26, 47, 110, 0.2);
    }

    /* RIGHT — Order summary */
    .order-summary-card {
        background: #fafafa;
        border-radius: 16px;
        padding: 2rem;
        border: 1px solid #eee;
    }

    .order-divider {
        border: none;
        border-top: 1px solid #eee;
        margin: 1.5rem 0;
    }

    .order-item-row {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 1rem 0;
    }

    .order-item-img {
        width: 50px;
        height: 70px;
        background: #fff;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border: 1px solid #eee;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }

    .order-item-info {
        flex: 1;
        min-width: 0;
    }

    .order-item-name {
        font-size: 0.95rem;
        font-weight: 700;
        color: #111;
        margin: 0 0 4px;
    }

    .order-item-details {
        font-size: 0.8rem;
        color: #888;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .order-item-price {
        font-size: 0.95rem;
        font-weight: 800;
        color: #111;
        white-space: nowrap;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
        color: #666;
        padding: 6px 0;
    }

    .summary-row.total {
        font-size: 1.35rem;
        font-weight: 900;
        color: #1a2f6e;
        margin-top: 1rem;
    }

    /* Payment method */
    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 2px solid #1a2f6e;
        border-radius: 50px;
        padding: 8px 20px;
        font-size: 0.8rem;
        font-weight: 700;
        color: #1a2f6e;
        margin-top: 10px;
        box-shadow: 0 4px 10px rgba(26, 47, 110, 0.1);
    }

    /* Shipping address display */
    .addr-display {
        font-size: 0.95rem;
        color: #444;
        line-height: 1.7;
        background: #fff;
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid #eee;
        margin-top: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .place-order-btn {
        display: block;
        width: 100%;
        margin-top: 2rem;
        background: #1a2f6e;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 1.1rem;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        cursor: pointer;
        text-align: center;
        transition: all 0.35s;
        box-shadow: 0 12px 25px rgba(26, 47, 110, 0.2);
    }

    .place-order-btn:hover:not(:disabled) {
        background: #0f2260;
        transform: translateY(-3px);
        box-shadow: 0 18px 35px rgba(26, 47, 110, 0.3);
    }

    /* Disabled state */
    .right-panel-locked {
        opacity: 0.65;
        filter: grayscale(0.2);
    }
</style>

<div class="checkout-overlay">
    <div class="checkout-panel">
        <a asp-controller="Cart" asp-action="Cart" class="checkout-close">✕</a>
        <h1 class="checkout-header">Checkout</h1>

        <div class="checkout-body">

            <!-- LEFT: Shipping Address Form -->
            <div>
                <p class="section-title">Shipping Information</p>
                <form asp-controller="Cart" asp-action="Checkout" method="post" id="shippingForm">
                    @Html.AntiForgeryToken()

                    <div class="form-row">
                        <div class="input-group">
                            <input class="co-input" asp-for="FirstName" placeholder="First Name" />
                        </div>
                        <div class="input-group">
                            <input class="co-input" asp-for="LastName" placeholder="Last Name" />
                        </div>
                    </div>
                    <div class="form-row full">
                        <input class="co-input" asp-for="Address" placeholder="House#/Street/Barangay/Landmark" />
                    </div>
                    <div class="form-row">
                        <input class="co-input" asp-for="City" placeholder="City" />
                        <input class="co-input" asp-for="ZipCode" placeholder="Zip Code" />
                    </div>
                    <div class="form-row full">
                        <input class="co-input" asp-for="Phone" placeholder="Mobile Number" />
                    </div>

                    <label class="default-addr-check">
                        <input type="checkbox" asp-for="IsDefaultAddress" />
                        Save this address for future orders
                    </label>

                    <div class="form-actions">
                        <a asp-controller="Cart" asp-action="Cart" class="return-link">
                            <span>←</span> Return to shopping bag
                        </a>
                        <button type="submit" class="submit-btn">Review Order</button>
                    </div>
                </form>
            </div>

            <!-- RIGHT: Order Summary -->
            <div class="order-summary-card @(addressSubmitted ? "" : "right-panel-locked")">
                <p class="section-title">Your Order</p>

                <div class="order-items-scroll" style="max-height: 350px; overflow-y: auto;">
                    @foreach (var item in cartItems)
                    {
                        <div class="order-item-row">
                            <div class="order-item-img">
                                <svg width="24" height="40" viewBox="0 0 70 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="24" y="0" width="22" height="10" rx="2.5" fill="#1a2f6e" opacity="0.7" />
                                    <rect x="27" y="9" width="16" height="16" rx="2" fill="#1a2f6e" opacity="0.85" />
                                    <rect x="6" y="23" width="58" height="84" rx="8" fill="#1a2f6e" />
                                </svg>
                            </div>
                            <div class="order-item-info">
                                <p class="order-item-name">@item.ProductName</p>
                                <p class="order-item-details">@item.Size | Qty: @item.Quantity</p>
                            </div>
                            <span class="order-item-price">₱@((item.Price * item.Quantity).ToString("N2"))</span>
                        </div>
                    }
                </div>

                <hr class="order-divider" />
                <div class="summary-row"><span>Subtotal</span><span>₱@subtotal.ToString("N2")</span></div>
                <div class="summary-row"><span>Shipping</span><span style="color:#28a745; font-weight:700;">FREE</span></div>
                <div class="summary-row"><span>Estimated Taxes</span><span>₱0.00</span></div>
                <hr class="order-divider" />
                <div class="summary-row total"><span>Total</span><span>₱@subtotal.ToString("N2")</span></div>

                <div style="margin-top:2.5rem;">
                    <p class="section-title">Payment</p>
                    <div class="payment-badge">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        Cash on Delivery
                    </div>
                </div>

                @if (addressSubmitted)
                {
                    <div style="margin-top:2.5rem;">
                        <p class="section-title">Ship To</p>
                        <div class="addr-display">
                            <strong>@Model.FirstName @Model.LastName</strong><br />
                            @Model.Address<br />
                            @Model.City, Philippines @Model.ZipCode<br />
                            @Model.Phone
                        </div>
                    </div>

                    <form asp-controller="Cart" asp-action="PlaceOrder" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="place-order-btn">Complete Purchase</button>
                    </form>
                }
                else
                {
                    <div style="margin-top:2.5rem;">
                        <p class="section-title">Ship To</p>
                        <div class="addr-display" style="color:#aaa; border-style:dashed; text-align:center;">
                            <em>Complete shipping details to proceed</em>
                        </div>
                    </div>
                    <button class="place-order-btn" disabled style="opacity:0.5; cursor:not-allowed;">Complete Purchase</button>
                }
            </div>

        </div>
    </div>
</div>
