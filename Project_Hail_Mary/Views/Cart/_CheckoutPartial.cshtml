@model Project_Hail_Mary.Models.CheckoutViewModel
@{
    var cartItems = ViewBag.CartItems as List<Project_Hail_Mary.Models.Cart> ?? new();
    var savedAddresses = ViewBag.UserAddresses as List<Project_Hail_Mary.Models.UserAddress> ?? new();
    decimal subtotal = cartItems.Sum(i => i.Price * i.Quantity);
    bool addressSubmitted = ViewBag.AddressSubmitted == true;
}

<div class="modal-header border-0 pb-0">
    <h1 class="modal-title fs-4 fw-bold" style="font-family: 'Playfair Display', serif;">Checkout</h1>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body py-4">
    <div class="row g-4">
        <!-- Shipping Form -->
        <div class="col-md-7">
            @if (savedAddresses.Any() && !addressSubmitted)
            {
                <h6 class="text-uppercase fw-bold text-primary mb-3" style="font-size: 0.8rem; letter-spacing: 0.05em;">Saved Addresses</h6>
                <div class="d-flex gap-2 overflow-auto pb-3 mb-4" style="scrollbar-width: thin;">
                    @foreach (var addr in savedAddresses)
                    {
                        <button type="button" class="btn btn-outline-dark text-start p-3 rounded-3" style="min-width: 200px; font-size: 0.85rem;" 
                                onclick="fillAddress('@addr.AddressLine', '@addr.City', '@addr.ZipCode', '@addr.PhoneNumber')">
                            <strong class="d-block mb-1">@addr.Label</strong>
                            <span class="text-muted d-block text-truncate" style="max-width: 150px;">@addr.AddressLine</span>
                            <span class="text-muted d-block">@addr.City @addr.ZipCode</span>
                        </button>
                    }
                </div>
            }

            <h6 class="text-uppercase fw-bold text-primary mb-3" style="font-size: 0.9rem; letter-spacing: 0.1em;">Shipping Information</h6>
            
            <form id="checkoutForm" onsubmit="submitCheckout(event)">
                @Html.AntiForgeryToken()
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <input class="form-control form-control-sm border-0 bg-light" asp-for="FirstName" placeholder="First Name" required />
                    </div>
                    <div class="col-6">
                        <input class="form-control form-control-sm border-0 bg-light" asp-for="LastName" placeholder="Last Name" required />
                    </div>
                </div>
                <div class="mb-2">
                    <input class="form-control form-control-sm border-0 bg-light" asp-for="Address" id="chkAddress" placeholder="Address" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-8">
                        <input class="form-control form-control-sm border-0 bg-light" asp-for="City" id="chkCity" placeholder="City" required />
                    </div>
                    <div class="col-4">
                        <input class="form-control form-control-sm border-0 bg-light" asp-for="ZipCode" id="chkZip" placeholder="Zip" required />
                    </div>
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-sm border-0 bg-light" asp-for="Phone" id="chkPhone" placeholder="Mobile Number" required />
                </div>

                @if (!addressSubmitted)
                {
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsDefaultAddress" id="saveAddress">
                        <label class="form-check-label text-muted" for="saveAddress" style="font-size: 0.9rem;">
                            Save address to profile
                        </label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold text-uppercase border-0" style="font-size: 1rem; letter-spacing: 0.1em;">
                        Review Order
                    </button>
                }
            </form>
        </div>

        <!-- Order Summary -->
        <div class="col-md-5">
            <div class="p-3 rounded-3" style="background: #fafafa; border: 1px solid #eee;">
                <h6 class="text-uppercase fw-bold mb-3" style="font-size: 0.9rem; letter-spacing: 0.1em;">Your Order</h6>
                
                <div class="order-items-mini mb-3" style="max-height: 250px; overflow-y: auto;">
                    @foreach (var item in cartItems)
                    {
                        <div class="d-flex align-items-center mb-3" style="font-size: 0.95rem; border-bottom: 1px solid #f0f0f0; padding-bottom: 8px;">
                            <div class="flex-shrink-0" style="width: 40px; height: 55px; background: #fff; border: 1px solid #eee; border-radius: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-right: 12px;">
                                <img src="/images/@(item.ProductSlug).png" alt="@item.ProductName" style="width: 100%; height: 100%; object-fit: contain;" onerror="this.src='/images/perfumes.jpg'" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-truncate" style="max-width: 150px;">@item.ProductName</div>
                                <div class="text-muted small">@item.Size x @item.Quantity</div>
                            </div>
                            <div class="text-end fw-bold">
                                ₱@((item.Price * item.Quantity).ToString("N2"))
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-2" />
                <div class="d-flex justify-content-between mb-1" style="font-size: 1rem;">
                    <span class="text-muted">Subtotal</span>
                    <span>₱@subtotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1" style="font-size: 1rem;">
                    <span class="text-muted">Shipping</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                    <span>Total</span>
                    <span class="text-primary">₱@subtotal.ToString("N2")</span>
                </div>

                @if (addressSubmitted)
                {
                    <div class="mt-4">
                        <h6 class="text-uppercase fw-bold mb-2" style="font-size: 0.85rem; letter-spacing: 0.05em;">Payment</h6>
                        <div class="d-flex align-items-center gap-2 p-2 bg-white border rounded-2 mb-3" style="font-size: 0.95rem;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                            Cash on Delivery
                        </div>

                        <form onsubmit="placeOrder(event)">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold text-uppercase border-0 shadow-sm" style="background: #1a2f6e; letter-spacing: 0.1em;">
                                Place Order
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
