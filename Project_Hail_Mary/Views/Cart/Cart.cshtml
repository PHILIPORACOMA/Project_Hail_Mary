@model List<Project_Hail_Mary.Models.Cart>
@{
    ViewData["Title"] = "Cart";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 bg-white shadow-sm rounded-4 p-0 overflow-hidden">
            @await Html.PartialAsync("_CartPartial", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Override some modal-specific behaviors if needed
        function openCheckout() {
            window.location.href = '/Cart/Checkout';
        }
        
        // Since we are on a full page, we might want to refresh the page on updates
        // but for now, the AJAX functions in _Layout might still work if they target the right container.
        // Let's refine the AJAX functions in _Layout to be more generic.
    </script>
}
