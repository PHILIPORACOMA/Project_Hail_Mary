<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            margin: 0;
            background: #fff;
        }

        .site-header {
            background: linear-gradient(160deg, rgba(13,27,62,0.75) 0%, rgba(30,48,96,0.75) 55%, rgba(10,20,40,0.75) 100%), url('/images/silk.jpeg') center/cover no-repeat;
        }

        .bazar-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2.5rem;
            height: 78px;
        }

        .nav-links {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 4px;
        }

            .nav-links a {
                color: rgba(255,255,255,0.75);
                font-size: 0.68rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 6px 12px;
                text-decoration: none;
            }

                .nav-links a:hover {
                    color: #fff;
                }

        /* Profile dropdown */
        .profile-dropdown {
            position: relative;
        }

        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 30px;
            transition: background 0.2s;
            background: none;
            border: none;
            list-style: none;
        }

            .profile-trigger:hover {
                background: rgba(255,255,255,0.08);
            }

        .profile-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1e3060, #4a6fa5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.05em;
            flex-shrink: 0;
        }

        .profile-name {
            color: rgba(255,255,255,0.85);
            font-size: 0.68rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .profile-caret {
            color: rgba(255,255,255,0.5);
            font-size: 0.55rem;
            transition: transform 0.2s;
        }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #0d1b3e;
            border-radius: 12px;
            box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            min-width: 190px;
            padding: 8px 0;
            z-index: 1000;
            animation: dropIn 0.18s ease;
        }


        @@keyframes dropIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .profile-dropdown.open .dropdown-menu-custom {
            display: block;
        }

        .profile-dropdown.open .profile-caret {
            transform: rotate(180deg);
        }

        .dropdown-header {
            padding: 12px 18px 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 4px;
        }

            .dropdown-header strong {
                display: block;
                font-size: 0.85rem;
                color: #fff;
                font-weight: 600;
            }

            .dropdown-header span {
                font-size: 0.73rem;
                color: rgba(255, 255, 255, 0.45);
            }

        .dropdown-item-custom {
            display: block;
            padding: 9px 18px;
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            letter-spacing: 0.04em;
            transition: background 0.15s;
        }

            .dropdown-item-custom:hover {
                background: rgba(255, 255, 255, 0.07);
                color: #fff;
            }

        .dropdown-divider-custom {
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
            margin: 4px 0;
        }

        .dropdown-item-custom.logout-item {
            color: #e07070;
        }

            .dropdown-item-custom.logout-item:hover {
                background: rgba(220, 80, 80, 0.12);
                color: #ff9090;
            }

        .brand-name {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.65rem;
            letter-spacing: 0.05em;
            display: block;
            text-align: center;
            text-decoration: none;
        }

        /* Cart Side Drawer Transition */
        .modal.fade .modal-dialog.modal-side-drawer {
            transform: translateX(100%);
            transition: transform 0.3s ease-out;
            margin: 0;
            margin-left: auto;
            height: 100%;
        }
        .modal.show .modal-dialog.modal-side-drawer {
            transform: translateX(0);
        }
        .modal-side-drawer .modal-content {
            height: 100%;
            border-radius: 0;
            border: none;
        }

        .brand-sub {
            display: block;
            font-size: 0.52rem;
            letter-spacing: 0.38em;
            color: #aab4c8;
            text-transform: uppercase;
            text-align: center;
        }

        .bazar-input {
            background-color: #eeeeee;
            border: none;
            border-radius: 30px;
            padding: 0.78rem 1.3rem;
            font-size: 0.87rem;
            width: 100%;
        }

            .bazar-input:focus {
                background-color: #e4e4e4;
                outline: none;
                box-shadow: 0 0 0 3px rgba(13,27,62,0.13);
            }

            .bazar-input::placeholder {
                color: #999;
            }

        .bazar-btn {
            background-color: #0d1b3e;
            color: #fff;
            border: none;
            border-radius: 30px;
            padding: 0.72rem 3rem;
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
            cursor: pointer;
        }

            .bazar-btn:hover {
                background-color: #1e3060;
                color: #fff;
            }

        .account-section {
            min-height: calc(100vh - 78px);
            display: flex;
        }

        .left-panel {
            flex: 0 0 42%;
            padding: 2.5rem;
            display: flex;
            align-items: stretch;
            max-height: 100vh;
            overflow: hidden;
        }

        .right-panel {
            flex: 1;
            padding: 3rem 3rem 3rem 4rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            width: 100%;
            max-width: 400px;
            margin: auto;
        }

        .form-title {
            font-size: 2.7rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 1.8rem;
        }

        @@media (max-width: 767px) {
            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 2rem 1.5rem;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <header class="site-header">
        <nav class="bazar-nav">
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Shop" asp-action="Shop">Shop</a></li>
                <li><a href="#">About</a></li>
            </ul>
            <div>
                <a asp-controller="Account" asp-action="Profile" class="dropdown-item-custom">My Profile</a>
                <span class="brand-sub">Bizarre</span>
            </div>
            <ul class="nav-links">
                <li><a href="#">Search</a></li>
                @{
                    var sessionFirstName = Context.Session.GetString("UserFirstName");
                    var sessionLastName = Context.Session.GetString("UserLastName");
                    var sessionEmail = Context.Session.GetString("UserEmail");
                    bool isLoggedIn = !string.IsNullOrEmpty(sessionFirstName);
                    var initials = isLoggedIn
                    ? $"{sessionFirstName![0]}{sessionLastName![0]}".ToUpper()
                    : "";
                    var fullName = isLoggedIn ? $"{sessionFirstName} {sessionLastName}" : "";
                }
                @if (isLoggedIn)
                {
                    <li class="profile-dropdown" id="profileDropdown">
                        <button class="profile-trigger" onclick="toggleDropdown(event)">
                            <span class="profile-avatar">@initials</span>
                            <span class="profile-name">@sessionFirstName</span>
                            <span class="profile-caret">&#9660;</span>
                        </button>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-header">
                                <strong>@fullName</strong>
                                <span>@sessionEmail</span>
                            </div>
                            <a asp-controller="Account" asp-action="Profile" class="dropdown-item-custom">My Profile</a>
                            <a href="#" class="dropdown-item-custom">My Orders</a>
                            <div class="dropdown-divider-custom"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item-custom logout-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer;">
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Account</a></li>
                }
                @{
                    int cartCount = 0;
                    var navUserId = Context.Session.GetInt32("UserId");
                    if (navUserId.HasValue)
                    {
                        var db = Context.RequestServices.GetService<AppDbContext>();
                        cartCount = db?.Cart.Where(c => c.UserId == navUserId.Value).Sum(c => c.Quantity) ?? 0;
                    }
                }
                <li><a href="javascript:void(0)" onclick="openCartModal()">Cart (<span id="cart-count">@cartCount</span>)</a></li>
            </ul>
        </nav>
    </header>

    @RenderBody()

    <!-- Cart Modal (Side Drawer) -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-side-drawer modal-md">
            <div class="modal-content" id="cartModalContent">
                <!-- Content loaded via AJAX -->
            </div>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="checkoutModalContent">
                <!-- Content loaded via AJAX -->
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleDropdown(e) {
            e.stopPropagation();
            document.getElementById('profileDropdown')?.classList.toggle('open');
        }
        document.addEventListener('click', function () {
            document.getElementById('profileDropdown')?.classList.remove('open');
        });

        // Cart & Checkout Logic
        const cartModal = new bootstrap.Modal(document.getElementById('cartModal'));
        const checkoutModal = new bootstrap.Modal(document.getElementById('checkoutModal'));

        function openCartModal() {
            fetch('/Cart/Cart', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => {
                    if (r.status === 401) {
                        window.location.href = '/Account/Login';
                        return;
                    }
                    return r.text();
                })
                .then(html => {
                    if (html) {
                        document.getElementById('cartModalContent').innerHTML = html;
                        cartModal.show();
                    }
                });
        }

        function updateCartQuantity(id, action) {
            const formData = new FormData();
            formData.append('cartItemId', id);
            formData.append('action', action);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.text()).then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
                refreshCartCount();
            });
        }

        function removeFromCart(id) {
            const formData = new FormData();
            formData.append('cartItemId', id);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/Cart/RemoveFromCart', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.text()).then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
                refreshCartCount();
            });
        }

        function openCheckout() {
            cartModal.hide();
            fetch('/Cart/Checkout', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    document.getElementById('checkoutModalContent').innerHTML = html;
                    checkoutModal.show();
                });
        }

        function submitCheckout(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            fetch('/Cart/Checkout', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.text()).then(html => {
                document.getElementById('checkoutModalContent').innerHTML = html;
            });
        }

        function placeOrder(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            fetch('/Cart/PlaceOrder', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => {
                if (r.redirected) {
                    window.location.href = r.url;
                }
            });
        }

        function refreshCartCount() {
            fetch('/Cart/Cart', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const items = doc.querySelectorAll('.cart-item-row');
                    let count = 0;
                    items.forEach(item => {
                        const qtyText = item.querySelector('.qty-value')?.textContent || item.querySelector('.px-2.fw-bold')?.textContent;
                        if (qtyText) count += parseInt(qtyText);
                    });
                    document.getElementById('cart-count').textContent = count;
                });
        }
    </script>
</body>
</html>