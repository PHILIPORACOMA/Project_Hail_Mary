<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'DM Sans', sans-serif;
            margin: 0;
            background: #fff;
        }

        .site-header {
            background: linear-gradient(160deg, rgba(13,27,62,0.75) 0%, rgba(30,48,96,0.75) 55%, rgba(10,20,40,0.75) 100%), url('/images/silk.jpeg') center/cover no-repeat;
        }

        .bazar-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2.5rem;
            height: 78px;
        }

        .nav-links {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 4px;
        }

            .nav-links a {
                color: rgba(255,255,255,0.75);
                font-size: 0.68rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 6px 12px;
                text-decoration: none;
            }

                .nav-links a:hover {
                    color: #fff;
                }

        /* Profile dropdown */
        .profile-dropdown {
            position: relative;
        }

        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 30px;
            transition: background 0.2s;
            background: none;
            border: none;
            list-style: none;
        }

            .profile-trigger:hover {
                background: rgba(255,255,255,0.08);
            }

        .profile-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1e3060, #4a6fa5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.05em;
            flex-shrink: 0;
        }

        .profile-name {
            color: rgba(255,255,255,0.85);
            font-size: 0.68rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .profile-caret {
            color: rgba(255,255,255,0.5);
            font-size: 0.55rem;
            transition: transform 0.2s;
        }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 8px);
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(13,27,62,0.18);
            min-width: 190px;
            padding: 8px 0;
            z-index: 1000;
            animation: dropIn 0.18s ease;
        }

        @@keyframes dropIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .profile-dropdown.open .dropdown-menu-custom {
            display: block;
        }

        .profile-dropdown.open .profile-caret {
            transform: rotate(180deg);
        }

        .dropdown-header {
            padding: 12px 18px 8px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 4px;
        }

            .dropdown-header strong {
                display: block;
                font-size: 0.85rem;
                color: #111;
                font-weight: 600;
            }

            .dropdown-header span {
                font-size: 0.73rem;
                color: #888;
            }

        .dropdown-item-custom {
            display: block;
            padding: 9px 18px;
            font-size: 0.78rem;
            color: #333;
            text-decoration: none;
            letter-spacing: 0.04em;
            transition: background 0.15s;
        }

            .dropdown-item-custom:hover {
                background: #f5f5f5;
                color: #0d1b3e;
            }

        .dropdown-divider-custom {
            height: 1px;
            background: #f0f0f0;
            margin: 4px 0;
        }

        .dropdown-item-custom.logout-item {
            color: #c0392b;
        }

            .dropdown-item-custom.logout-item:hover {
                background: #fdf0ef;
                color: #c0392b;
            }

        .brand-name {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.65rem;
            letter-spacing: 0.05em;
            display: block;
            text-align: center;
            text-decoration: none;
        }

        .brand-sub {
            display: block;
            font-size: 0.52rem;
            letter-spacing: 0.38em;
            color: #aab4c8;
            text-transform: uppercase;
            text-align: center;
        }

        .bazar-input {
            background-color: #eeeeee;
            border: none;
            border-radius: 30px;
            padding: 0.78rem 1.3rem;
            font-size: 0.87rem;
            width: 100%;
        }

            .bazar-input:focus {
                background-color: #e4e4e4;
                outline: none;
                box-shadow: 0 0 0 3px rgba(13,27,62,0.13);
            }

            .bazar-input::placeholder {
                color: #999;
            }

        .bazar-btn {
            background-color: #0d1b3e;
            color: #fff;
            border: none;
            border-radius: 30px;
            padding: 0.72rem 3rem;
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
            cursor: pointer;
        }

            .bazar-btn:hover {
                background-color: #1e3060;
                color: #fff;
            }

        .account-section {
            min-height: calc(100vh - 78px);
            display: flex;
        }

        .left-panel {
            flex: 0 0 42%;
            padding: 2.5rem;
            display: flex;
            align-items: stretch;
            max-height: 100vh;
            overflow: hidden;
        }

        .right-panel {
            flex: 1;
            padding: 3rem 3rem 3rem 4rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-card {
            width: 100%;
            max-width: 400px;
            margin: auto;
        }

        .form-title {
            font-size: 2.7rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 1.8rem;
        }

        @@media (max-width: 767px) {
            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 2rem 1.5rem;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <header class="site-header">
        <nav class="bazar-nav">
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Shop" asp-action="Shop">Shop</a></li>
                <li><a href="#">About</a></li>
            </ul>
            <div>
                <a asp-controller="Account" asp-action="Login" class="brand-name">bəzár</a>
                <span class="brand-sub">Bizarre</span>
            </div>
            <ul class="nav-links">
                <li><a href="#">Search</a></li>
                @{
                    var sessionFirstName = Context.Session.GetString("UserFirstName");
                    var sessionLastName = Context.Session.GetString("UserLastName");
                    var sessionEmail = Context.Session.GetString("UserEmail");
                    bool isLoggedIn = !string.IsNullOrEmpty(sessionFirstName);
                    var initials = isLoggedIn
                    ? $"{sessionFirstName![0]}{sessionLastName![0]}".ToUpper()
                    : "";
                    var fullName = isLoggedIn ? $"{sessionFirstName} {sessionLastName}" : "";
                }
                @if (isLoggedIn)
                {
                    <li class="profile-dropdown" id="profileDropdown">
                        <button class="profile-trigger" onclick="toggleDropdown(event)">
                            <span class="profile-avatar">@initials</span>
                            <span class="profile-name">@sessionFirstName</span>
                            <span class="profile-caret">&#9660;</span>
                        </button>
                        <div class="dropdown-menu-custom">
                            <div class="dropdown-header">
                                <strong>@fullName</strong>
                                <span>@sessionEmail</span>
                            </div>
                            <a href="#" class="dropdown-item-custom">My Profile</a>
                            <a href="#" class="dropdown-item-custom">My Orders</a>
                            <div class="dropdown-divider-custom"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item-custom logout-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer;">
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Account</a></li>
                }
                <li><a href="#">Cart (0)</a></li>
            </ul>
        </nav>
    </header>

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleDropdown(e) {
            e.stopPropagation();
            document.getElementById('profileDropdown')?.classList.toggle('open');
        }
        document.addEventListener('click', function () {
            document.getElementById('profileDropdown')?.classList.remove('open');
        });
    </script>
</body>
</html>