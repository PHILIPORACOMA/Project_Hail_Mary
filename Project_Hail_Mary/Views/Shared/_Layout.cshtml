<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var title = ViewData["Title"]?.ToString();
        bool isHome = title == "Home" || title == "Shop";
    }

    <header class="site-header @(!isHome ? "header-solid" : "")">
        <nav class="bazar-nav">
            <!-- Left Group -->
            <div class="nav-group">
                <ul class="nav-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Shop" asp-action="Shop">Shop</a></li>
                    <li><a href="/#about">About</a></li>
                </ul>
            </div>

            <!-- Center Brand -->
            <div class="brand-center">
                <a asp-controller="Home" asp-action="Index" class="brand-name">bəzár</a>
                <span class="brand-sub">Bizarre</span>
            </div>

            <!-- Right Group -->
            <div class="nav-group nav-group-right">
                <ul class="nav-links">
                    <li>
                        <button type="button" class="nav-icon-link" onclick="openSearchModal()">
                            Search
                        </button>
                    </li>
                    @{
                        var sessionFirstName = Context.Session.GetString("UserFirstName");
                        var sessionLastName = Context.Session.GetString("UserLastName");
                        var sessionEmail = Context.Session.GetString("UserEmail");
                        var sessionProfilePic = Context.Session.GetString("UserProfilePicture");
                        bool isLoggedIn = !string.IsNullOrEmpty(sessionFirstName);
                        var initials = isLoggedIn
                        ? $"{sessionFirstName![0]}{sessionLastName![0]}".ToUpper()
                        : "";
                        var fullName = isLoggedIn ? $"{sessionFirstName} {sessionLastName}" : "";
                    }
                    @if (isLoggedIn)
                    {
                        <li>
                            <button type="button" class="nav-icon-link" onclick="openAccountModal()">
                                Account
                            </button>
                        </li>
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Login">Account</a></li>
                    }
                    @{
                        int cartCount = 0;
                        var navUserId = Context.Session.GetInt32("UserId");
                        if (navUserId.HasValue)
                        {
                            var db = Context.RequestServices.GetService<AppDbContext>();
                            cartCount = db?.Cart.Where(c => c.UserId == navUserId.Value).Count() ?? 0;
                        }
                    }
                    <li>
                        <a href="javascript:void(0)" onclick="openCartModal()" class="nav-icon-link">
                            Cart <span class="cart-badge" id="cart-count" data-count="@cartCount">@cartCount</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    @RenderBody()

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-brand">bəzár</div>
        <div class="footer-sub">Bizarre</div>
        <div class="footer-copyright">&copy; @DateTime.Now.Year bəzár Bizarre. All rights reserved.</div>
    </footer>

    <!-- Account Modal (Side Drawer) -->
    <div class="modal fade" id="accountModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-side-drawer">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h1 class="modal-title fs-4 fw-bold" style="font-family: 'Playfair Display', serif;">My Account</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    @{
                        var modalFirstName = Context.Session.GetString("UserFirstName");
                        var modalLastName = Context.Session.GetString("UserLastName");
                        var modalEmail = Context.Session.GetString("UserEmail");
                        var modalProfilePic = Context.Session.GetString("UserProfilePicture");
                        bool isModalLoggedIn = !string.IsNullOrEmpty(modalFirstName);
                        var modalInitials = isModalLoggedIn
                        ? $"{modalFirstName![0]}{modalLastName![0]}".ToUpper()
                        : "";
                        var modalFullName = isModalLoggedIn ? $"{modalFirstName} {modalLastName}" : "";
                    }
                    @if (isModalLoggedIn)
                    {
                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(modalProfilePic))
                            {
                                <img src="@modalProfilePic" alt="Profile" class="profile-avatar mx-auto mb-3" style="width:80px; height:80px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="profile-avatar mx-auto mb-3" style="width:80px; height:80px; font-size:1.5rem;">@modalInitials</div>
                            }
                            <strong class="d-block fs-5 text-dark">@modalFullName</strong>
                            <span class="text-muted">@modalEmail</span>
                        </div>
                        
                        <div class="d-flex flex-column gap-2 px-3">
                            <a asp-controller="Account" asp-action="Profile" class="bazar-btn w-100 py-3 text-center" style="background: transparent; color: #111; border: 1.5px solid #111;">My Profile</a>
                            <a asp-controller="Account" asp-action="Orders" class="bazar-btn w-100 py-3 text-center" style="background: transparent; color: #111; border: 1.5px solid #111;">My Orders</a>
                            
                            <hr class="my-3 text-muted" />
                            
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bazar-btn w-100 py-3 text-center">
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Search Modal (Side Drawer) -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-side-drawer">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h1 class="modal-title fs-4 fw-bold" style="font-family: 'Playfair Display', serif;">Search</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="search-input-group">
                        <input type="text" id="searchModalInput" class="search-input-drawer" placeholder="Search for products..." oninput="runModalSearch(this.value)">
                        <div class="search-input-icon">
                            ✕
                        </div>
                    </div>
                    <div id="searchModalResults">
                        <!-- Results will appear here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cart Modal (Side Drawer) -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-side-drawer modal-md">
            <div class="modal-content" id="cartModalContent">
                <!-- Content loaded via AJAX -->
            </div>
        </div>
    </div>

    <!-- Checkout Modal -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="checkoutModalContent">
                <!-- Content loaded via AJAX -->
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const allProducts = [
            { name: "Afro",     slug: "afro",     category: "men"   },
            { name: "Cloud",    slug: "cloud",    category: "women" },
            { name: "Florise",  slug: "florise",  category: "women" },
            { name: "Quiff",    slug: "quiff",    category: "men"   },
            { name: "Enchantè", slug: "enchante", category: "women" },
            { name: "Antheia",  slug: "antheia",  category: "women" },
            { name: "Hygea",    slug: "hygea",    category: "women" },
            { name: "Temple",   slug: "temple",   category: "men"   },
            { name: "Athena",   slug: "athena",   category: "women" },
            { name: "Mullet",   slug: "mullet",   category: "men"   },
            { name: "Slick",    slug: "slick",    category: "men"   },
            { name: "Aphrora",  slug: "aphrora",  category: "women" },
            { name: "Taper",    slug: "taper",    category: "men"   },
            { name: "Buzz",     slug: "buzz",     category: "men"   },
        ];

        const searchModal = new bootstrap.Modal(document.getElementById('searchModal'));
        const cartModal = new bootstrap.Modal(document.getElementById('cartModal'));
        const checkoutModal = new bootstrap.Modal(document.getElementById('checkoutModal'));
        const accountModal = new bootstrap.Modal(document.getElementById('accountModal'));

        function openAccountModal() {
            accountModal.show();
        }

        function openSearchModal() {
            searchModal.show();
            setTimeout(() => document.getElementById('searchModalInput').focus(), 500);
        }

        function runModalSearch(query) {
            const results = document.getElementById('searchModalResults');
            if (!query.trim()) { results.innerHTML = ''; return; }

            const matches = allProducts.filter(p =>
                p.name.toLowerCase().includes(query.toLowerCase())
            );

            if (matches.length === 0) {
                results.innerHTML = '<p class="text-muted small">No products found.</p>';
                return;
            }

            results.innerHTML = matches.map(p => `
                <a href="/Shop/ProductDetail?slug=${p.slug}&name=${encodeURIComponent(p.name)}&category=${p.category}"
                   class="search-result-item">
                    <img src="/images/${p.slug}.png" alt="${p.name}" class="search-result-img" onerror="this.style.opacity='0'" />
                    <div class="search-result-info">
                        <div class="name">${p.name}</div>
                        <div class="category">${p.category}</div>
                    </div>
                </a>
            `).join('');
        }

        function toggleDropdown(e) {
            e.stopPropagation();
            document.getElementById('profileDropdown')?.classList.toggle('open');
        }
        document.addEventListener('click', function () {
            document.getElementById('profileDropdown')?.classList.remove('open');
        });

        function openCartModal() {
            fetch('/Cart/Cart', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => {
                    if (r.status === 401) {
                        window.location.href = '/Account/Login';
                        return;
                    }
                    return r.text();
                })
                .then(html => {
                    if (html) {
                        document.getElementById('cartModalContent').innerHTML = html;
                        cartModal.show();
                    }
                });
        }

        function updateCartQuantity(id, action) {
            const formData = new FormData();
            formData.append('cartItemId', id);
            formData.append('action', action);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.text()).then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
                refreshCartCount();
            });
        }

        function removeFromCart(id) {
            const formData = new FormData();
            formData.append('cartItemId', id);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/Cart/RemoveFromCart', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.text()).then(html => {
                document.getElementById('cartModalContent').innerHTML = html;
                refreshCartCount();
            });
        }

        function openCheckout() {
            cartModal.hide();
            fetch('/Cart/Checkout', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    document.getElementById('checkoutModalContent').innerHTML = html;
                    checkoutModal.show();
                });
        }

        function refreshCartCount() {
            fetch('/Cart/Cart', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const items = doc.querySelectorAll('.cart-item-row');
                    const badge = document.getElementById('cart-count');
                    badge.textContent = items.length;
                    badge.setAttribute('data-count', items.length);
                });
        }

        function submitCheckout(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const container = document.getElementById('checkoutModalContent') || document.getElementById('checkoutPageContent');

            fetch('/Cart/Checkout', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.text())
            .then(html => {
                if (container) container.innerHTML = html;
            });
        }

        function placeOrder(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);
            const container = document.getElementById('checkoutModalContent') || document.getElementById('checkoutPageContent');

            fetch('/Cart/PlaceOrder', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => {
                if (r.redirected) {
                    window.location.href = r.url;
                } else {
                    return r.text();
                }
            })
            .then(html => {
                if (html && container) {
                    container.innerHTML = html;
                }
            });
        }
    </script>
</body>
</html>