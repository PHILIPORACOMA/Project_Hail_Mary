﻿@{
ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d1b3e;
            --navy-mid: #1a2f6e;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        /* NAV */
        .navbar-bazar {
            background-color: var(--navy);
            padding: 0 2rem;
            height: 62px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .navbar-bazar .nav-link {
                color: #c8d3e8 !important;
                font-size: 0.7rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 0.35rem 0.6rem !important;
                transition: color 0.2s;
            }

                .navbar-bazar .nav-link:hover {
                    color: #fff !important;
                }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.55rem;
            letter-spacing: 0.04em;
            line-height: 1;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 0.52rem;
            letter-spacing: 0.3em;
            color: #8a9ab8;
            text-transform: uppercase;
            text-align: center;
            display: block;
            margin-top: 2px;
        }

        /* HERO */
        .hero-section {
            position: relative;
            min-height: clamp(400px, 60vh, 700px);
            display: flex;
            align-items: center;
            overflow: hidden;
            background: linear-gradient(120deg, #0b1838 0%, #162255 40%, #1c3070 100%);
        }



        .hero-silk {
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(118deg, transparent 0px, rgba(255,255,255,0.025) 1px, transparent 2px, transparent 60px), repeating-linear-gradient(62deg, transparent 0px, rgba(255,255,255,0.015) 1px, transparent 2px, transparent 80px);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            padding: clamp(2rem, 5vw, 4rem) 0;
        }

            .hero-content h1 {
                font-family: 'DM Sans', sans-serif;
                font-weight: 900;
                font-size: clamp(3.5rem, 10vw, 6.5rem);
                font-weight: 700;
                color: #fff;
                line-height: 1.1;
                margin-bottom: 2.2rem;
                text-transform: uppercase;
                letter-spacing: 0.02em;
            }

        .btn-shop-outline {
            background-color: transparent;
            color: #fff;
            border: 1.5px solid rgba(255,255,255,0.7);
            border-radius: 50px;
            padding: 1rem 2.5rem;
            font-size: clamp(0.75rem, 1.2vw, 0.9rem);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
            text-decoration: none;
        }

            .btn-shop-outline:hover {
                background-color: rgba(255,255,255,0.12);
                color: #fff;
                border-color: #fff;
            }

        .hero-products {
            position: relative;
            z-index: 2;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            padding: 2rem 0;
        }

        .bottle-group {
            display: flex;
            gap: 1.5rem;
            align-items: flex-end;
        }

        .bottle-svg-hero {
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
        }

        /* ABOUT */
        .about-section {
            padding: clamp(3rem, 8vw, 8rem) 0;
            background: #fff;
        }

        .about-img-placeholder {
            width: 100%;
            aspect-ratio: 1/1;
            max-width: 420px;
            background: linear-gradient(135deg, #1a2f6e 0%, #0d1b3e 100%);
            border-radius: 4px;
            display: grid;
            grid-template-columns: repeat(3,1fr);
            grid-template-rows: repeat(3,1fr);
            gap: 8px;
            padding: 20px;
        }

        .mini-bottle {
            background: rgba(255,255,255,0.08);
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .about-text-wrap {
            padding-left: clamp(1rem, 4vw, 3rem);
        }

            .about-text-wrap h2 {
                font-family: 'DM Sans', sans-serif;
                font-size: clamp(2.5rem, 6vw, 4rem);
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                color: #111;
                margin-bottom: 1.5rem;
            }

        .about-tagline {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            font-size: clamp(1.1rem, 2vw, 1.4rem);
            color: #555;
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .about-body {
            font-size: clamp(1rem, 1.3vw, 1.15rem);
            color: #555;
            line-height: 1.8;
            margin-bottom: 1.2rem;
        }

        /* COLLECTION */
        .collection-section {
            padding: 4rem 0 7rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 3rem;
        }

            .section-header h2 {
                font-family: 'DM Sans', sans-serif;
                font-size: clamp(2rem, 4vw, 3rem);
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #111;
                margin: 0;
            }

        .btn-see-all {
            background: transparent;
            border: 1px solid #ccc;
            border-radius: 50px;
            padding: 0.6rem 1.8rem;
            font-size: clamp(0.75rem, 1.2vw, 0.9rem);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #555;
            text-decoration: none;
            transition: all 0.25s;
        }

            .btn-see-all:hover {
                border-color: var(--navy);
                color: var(--navy);
            }

        .product-card {
            background: #f9f9f9;
            border-radius: 8px;
            padding: 2.5rem 1.5rem 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.25s, box-shadow 0.25s;
        }

            .product-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 32px rgba(0,0,0,0.08);
            }

        .product-img-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .product-name {
            font-size: clamp(1rem, 1.3vw, 1.2rem);
            font-weight: 500;
            color: #222;
            letter-spacing: 0.06em;
            margin-bottom: 1.2rem;
            text-align: center;
        }

        .btn-buy {
            background-color: var(--navy);
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0.8rem 2.2rem;
            font-size: clamp(0.75rem, 1.2vw, 0.9rem);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
            display: inline-block;
        }

            .btn-buy:hover {
                background-color: var(--navy-mid);
                color: #fff;
            }

        /* FOOTER */
        .site-footer {
            background: linear-gradient(135deg, #162255 0%, #0d1b3e 100%);
            padding: 5rem 2rem;
            text-align: center;
        }

        .footer-brand {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: clamp(3rem, 10vw, 5rem);
            letter-spacing: 0.04em;
            line-height: 1;
        }

        .footer-sub {
            font-size: clamp(0.7rem, 1.5vw, 1rem);
            letter-spacing: 0.4em;
            color: #8a9ab8;
            text-transform: uppercase;
            margin-top: 10px;
        }

        @@media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2rem;
            }

            .about-text-wrap {
                padding-left: 0;
                margin-top: 2rem;
            }

            .hero-section {
                min-height: auto;
            }
        }
    </style>
</head>
<body>


    <!-- HERO -->
    <section class="hero-section">
        <div class="hero-silk"></div>
        <div class="container-fluid" style="padding: 0 clamp(2rem, 5vw, 6rem);">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <h1>Skip the<br />ordinary.<br />Wear the<br />unexpected.</h1>
                        <a asp-controller="Shop" asp-action="Shop" class="btn-shop-outline">Shop the collection</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-products">
                        <img src="/images/featured.png" alt="Featured Collection"
                             style="width:100%; max-height:clamp(400px, 60vh, 700px); object-fit:contain;
                    filter:drop-shadow(0 20px 60px rgba(0,0,0,0.7));
                    margin-bottom:-62px;" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- THE MAGIC OF BIZARRE -->
    <section class="about-section">
        <div class="container-fluid" style="padding: 0 clamp(2rem, 5vw, 6rem);">
            <div class="row align-items-center g-5">
                <div class="col-md-5">
                    <!-- Replace this div with <img src="~/images/about-collection.jpg" ... /> when ready -->
                    <img src="/images/flat.jpg" alt="Silk"
                         style="width:100%; max-width:600px; border-radius:4px;
            object-fit:cover; aspect-ratio:1/1;" />
                </div>
                <div class="col-md-7">
                    <div class="about-text-wrap">
                        <h2>The Magic of<br />Bizarre</h2>
                        <p class="about-tagline">"Luxury should be intimate. It should be felt."</p>
                        <p class="about-body">Bəzár Bizarre is built on a different idea: that fragrance isn't about status, but experience. It's about the quiet confidence of a scent that is entirely, undeniably yours.</p>
                        <p class="about-body">In a world where luxury is often exaggerated and overpriced, Bəzár Bizarre strips it back to what truly matters: careful formulation, balanced composition, and fragrances that embed naturally on the skin.</p>
                        <p class="about-body">Each scent is crafted to be expressive, memorable, and accessible — because true luxury isn't about the price tag. It's about how it makes you feel.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- OUR COLLECTION -->
    <section class="collection-section">
        <div class="container-fluid" style="padding: 0 clamp(2rem, 5vw, 6rem);">
            <div class="section-header">
                <h2>Our Collection</h2>
                <a asp-controller="Shop" asp-action="Index" class="btn-see-all">See All</a>
            </div>
            <div class="row g-4">
                @{
                    var featured = new[] {
                                new { Name = "Enchantè", Slug = "enchante" },
                                new { Name = "Mullet",   Slug = "mullet"   },
                                new { Name = "Cloud",  Slug = "cloud"  },
                                new { Name = "Buzz",     Slug = "buzz"     },
                                };
                }
                @foreach (var p in featured)
                {
                    <div class="col-6 col-md-3">
                        <div class="product-card">
                            <div class="product-img-wrap">
                                <img src="/images/@(p.Slug).png" alt="@p.Name"
                                     style="height:clamp(150px, 20vh, 250px); object-fit:contain;" />
                            </div>
                            <p class="product-name">@p.Name</p>
                            <a href="#" class="btn-buy">Buy Now</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-brand">bəzár</div>
        <div class="footer-sub">Bizarre</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>