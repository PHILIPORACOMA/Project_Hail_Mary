@{
    ViewData["Title"] = "Home";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;600;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: url('/images/silk.jpeg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

            /* Dark overlay over silk background */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: linear-gradient(135deg, rgba(6,16,31,0.82) 0%, rgba(13,27,62,0.78) 40%, rgba(18,33,84,0.75) 70%, rgba(10,20,40,0.82) 100%);
                z-index: 0;
            }

        nav, .hero-body {
            position: relative;
            z-index: 1;
        }

        .hero-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2.5rem;
            height: 78px;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 4px;
            align-items: center;
        }

            .nav-links a {
                color: rgba(255,255,255,0.75);
                font-size: 0.68rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 6px 12px;
                text-decoration: none;
            }

                .nav-links a:hover {
                    color: #fff;
                }

        .btn-logout {
            background: none;
            border: none;
            color: rgba(255,255,255,0.75);
            font-size: 0.68rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 500;
            padding: 6px 12px;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
        }

            .btn-logout:hover {
                color: #fff;
            }

        .brand-name {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.65rem;
            letter-spacing: 0.05em;
            display: block;
            text-align: center;
            text-decoration: none;
        }

        .brand-sub {
            display: block;
            font-size: 0.52rem;
            letter-spacing: 0.38em;
            color: #aab4c8;
            text-transform: uppercase;
            text-align: center;
        }

        .hero-body {
            flex: 1;
            display: flex;
            align-items: center;
            padding: 2rem 2.5rem 4rem;
        }

        .hero-row {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }

        .hero-left {
            flex: 0 0 50%;
        }

        .hero-headline {
            font-size: clamp(2.4rem, 5vw, 4rem);
            font-weight: 800;
            line-height: 1.08;
            text-transform: uppercase;
            margin-bottom: 2.2rem;
        }

        .btn-hero {
            display: inline-block;
            border: 1.5px solid rgba(255,255,255,0.7);
            color: #fff;
            border-radius: 40px;
            padding: 0.75rem 2.4rem;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 600;
            text-decoration: none;
        }

            .btn-hero:hover {
                background: rgba(255,255,255,0.1);
                color: #fff;
            }

        .hero-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-stack {
            position: relative;
            width: 380px;
            height: 440px;
        }

            .product-stack img {
                position: absolute;
                object-fit: cover;
            }

            /* Back image — featured, top-right, behind */
            .product-stack .img-back {
                width: 300px;
                height: 380px;
                top: 0;
                right: 0;
                border-radius: 12px;
                z-index: 1;
            }

            /* Front image — perfumes, bottom-left, in front */
            .product-stack .img-front {
                width: 200px;
                height: 280px;
                bottom: 0;
                left: 0;
                border-radius: 12px;
                box-shadow: 0 30px 80px rgba(0,0,0,0.6);
                z-index: 2;
            }

        @@media (max-width: 768px) {
            .hero-left {
                flex: 0 0 100%;
            }

            .hero-right {
                display: none;
            }
        }
    </style>
</head>
<body>

    <nav class="hero-nav">
        <ul class="nav-links">
            <li><a href="/home">Home</a></li>
            <li><a href="#">Shop</a></li>
            <li><a href="#">About</a></li>
        </ul>
        <div>
            <a href="/home" class="brand-name">bəzár</a>
            <span class="brand-sub">Bizarre</span>
        </div>
        <ul class="nav-links">
            <li><a href="#">Search</a></li>
            <li><a href="/account/login">Account</a></li>
            <li><a href="#">Cart (0)</a></li>
            <li>
                <form action="/account/logout" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout">Logout</button>
                </form>
            </li>
        </ul>
    </nav>

    <div class="hero-body">
        <div class="hero-row">
            <div class="hero-left">
                <h1 class="hero-headline">
                    Skip the ordinary.<br />
                    Wear the<br />
                    unexpected.
                </h1>
                <a href="#" class="btn-hero">Shop the Collection</a>
            </div>
            <div class="hero-right">
                <img class="img-back" src="~/images/featured.png" alt="Perfume featured" />
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
