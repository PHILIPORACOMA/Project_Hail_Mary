@model Project_Hail_Mary.Models.Users
@{
    ViewData["Title"] = "My Profile";
}

<div style="display:flex; min-height:calc(100vh - 78px); max-width:clamp(800px, 95vw, 1400px); margin:0 auto; padding:clamp(1rem, 5vw, 2.5rem) 1.5rem; gap:clamp(1rem, 3vw, 2.5rem); flex-wrap: wrap;">

    <!-- Left nav -->
    <aside style="width:clamp(150px, 18vw, 220px); flex-shrink:0; padding-top:0.5rem;">
        <a href="#" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#111; text-decoration:none; padding:6px 0; border-bottom:1px solid #111; margin-bottom:8px; font-weight:500;">Account Overview</a>
        <a asp-controller="Account" asp-action="Orders" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#555; text-decoration:none; padding:6px 0;">Orders</a>
    </aside>

    <!-- Divider -->
    <div style="width:1px; background:#e0e0e0; flex-shrink:0; align-self: stretch;"></div>

    <!-- Main content -->
    <main style="flex:1; min-width: 300px;">

        <!-- Avatar + greeting -->
        <div style="display:flex; align-items:center; gap:clamp(1.5rem, 4vw, 3rem); margin-bottom:2rem; flex-wrap: wrap;">
            <div style="text-align:center;">
                <form asp-controller="Account" asp-action="UploadPicture" method="post" enctype="multipart/form-data" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <label for="picInput" style="cursor:pointer; display:block;">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                        {
                            <img src="@Model.ProfilePicture" alt="Profile" style="width:clamp(80px, 12vw, 120px); height:clamp(80px, 12vw, 120px); border-radius:50%; object-fit:cover; border:2px solid #111;" />
                        }
                        else
                        {
                            <div class="profile-avatar mx-auto" style="width:clamp(80px, 12vw, 120px); height:clamp(80px, 12vw, 120px); font-size:2rem; display:flex; align-items:center; justify-content:center; background:#eee; border-radius:50%; color:#555;">
                                @(Model.FirstName[0])@(Model.LastName[0])
                            </div>
                        }
                    </label>
                    <input id="picInput" type="file" name="profilePicture" accept="image/*" style="display:none;" onchange="this.form.submit()" />
                </form>
                <span style="display:block; font-size:0.9rem; color:#111; margin-top:8px; font-weight:700; cursor:pointer; text-transform:uppercase;" onclick="document.getElementById('picInput').click()">
                    Edit Photo
                </span>
            </div>
            <h1 style="font-size:clamp(2.5rem, 6vw, 3.8rem); font-weight:700; margin:0; color:#111; font-family:'DM Sans', sans-serif;">Hi, @Model.FirstName!</h1>
        </div>

        <hr style="border:none; border-top:1px solid #e0e0e0; margin:0 0 2rem;" />

        <!-- Personal Details Section -->
        <div style="margin-bottom:3rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                <p style="font-size:clamp(1rem, 1.4vw, 1.2rem); font-weight:700; color:#111; margin:0; text-transform:uppercase; letter-spacing:0.05em;">Personal Details</p>
                @if (ViewBag.EditingInfo != true)
                {
                    <a asp-controller="Account" asp-action="Profile" asp-route-edit="info" style="color:var(--navy); font-weight:600; text-decoration:none;">Edit Details</a>
                }
            </div>

            @if (ViewBag.EditingInfo == true)
            {
                <form asp-controller="Account" asp-action="UpdateProfile" method="post" style="max-width: 800px;">
                    @Html.AntiForgeryToken()
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            <label style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase;">First Name</label>
                            <input type="text" name="firstName" value="@Model.FirstName" style="padding:12px 20px; border:1.5px solid #111; border-radius:30px; font-size:1.1rem; width:100%;" required />
                        </div>
                        <div>
                            <label style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase;">Last Name</label>
                            <input type="text" name="lastName" value="@Model.LastName" style="padding:12px 20px; border:1.5px solid #111; border-radius:30px; font-size:1.1rem; width:100%;" required />
                        </div>
                    </div>
                    <div style="margin-bottom:1.5rem;">
                        <label style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase;">Email Address</label>
                        <input type="email" name="email" value="@Model.Email" style="padding:12px 20px; border:1.5px solid #111; border-radius:30px; font-size:1.1rem; width:100%;" required />
                    </div>
                    <div style="margin-bottom:2rem;">
                        <label style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase;">Birthdate</label>
                        <input type="date" name="dateOfBirth" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" style="padding:12px 20px; border:1.5px solid #111; border-radius:30px; font-size:1.1rem; width:100%;" />
                    </div>

                    <button type="submit" style="padding:14px 44px; background:#0d1b3e; color:#fff; border:none; border-radius:30px; font-size:0.95rem; letter-spacing:0.12em; text-transform:uppercase; font-weight:700; cursor:pointer;">
                        Save Changes
                    </button>
                    <a asp-controller="Account" asp-action="Profile" style="font-size:1rem; color:#888; text-decoration:underline; margin-left:15px;">Cancel</a>
                </form>
            }
            else
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; padding-left: 12px;">
                    <div>
                        <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Email</p>
                        <p style="font-size:1.1rem; color:#111; margin:0;">@Model.Email</p>
                    </div>
                    <div>
                        <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Birthdate</p>
                        <p style="font-size:1.1rem; color:#111; margin:0;">@(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not set")</p>
                    </div>
                </div>
            }
        </div>

        <hr style="border:none; border-top:1px solid #e0e0e0; margin:0 0 3rem;" />

        <!-- Address Book Section -->
        <div style="margin-bottom:3rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                <p style="font-size:clamp(1rem, 1.4vw, 1.2rem); font-weight:700; color:#111; margin:0; text-transform:uppercase; letter-spacing:0.05em;">Address Book</p>
                <button type="button" onclick="showAddAddress()" style="background:none; border:none; color:var(--navy); font-weight:600; cursor:pointer;">+ Add New Address</button>
            </div>

            <!-- Add Address Form (Hidden by default) -->
            <div id="addAddressForm" style="display:none; background:#f9f9f9; padding:2rem; border-radius:16px; margin-bottom:2rem; border:1px solid #eee;">
                <form asp-controller="Account" asp-action="AddAddress" method="post">
                    @Html.AntiForgeryToken()
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            <label style="font-size:0.8rem; font-weight:700; color:#888; text-transform:uppercase;">Label (e.g. Home, Office)</label>
                            <input type="text" name="label" placeholder="Home" style="padding:10px 18px; border:1px solid #ccc; border-radius:30px; width:100%;" required />
                        </div>
                        <div>
                            <label style="font-size:0.8rem; font-weight:700; color:#888; text-transform:uppercase;">Phone Number</label>
                            <input type="text" name="phoneNumber" placeholder="09123456789" style="padding:10px 18px; border:1px solid #ccc; border-radius:30px; width:100%;" required />
                        </div>
                    </div>
                    <div style="margin-bottom:1.5rem;">
                        <label style="font-size:0.8rem; font-weight:700; color:#888; text-transform:uppercase;">Street Address</label>
                        <input type="text" name="addressLine" placeholder="123 Street Name" style="padding:10px 18px; border:1px solid #ccc; border-radius:30px; width:100%;" required />
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                        <div>
                            <label style="font-size:0.8rem; font-weight:700; color:#888; text-transform:uppercase;">City</label>
                            <input type="text" name="city" placeholder="Manila" style="padding:10px 18px; border:1px solid #ccc; border-radius:30px; width:100%;" required />
                        </div>
                        <div>
                            <label style="font-size:0.8rem; font-weight:700; color:#888; text-transform:uppercase;">Zip Code</label>
                            <input type="text" name="zipCode" placeholder="1000" style="padding:10px 18px; border:1px solid #ccc; border-radius:30px; width:100%;" required />
                        </div>
                    </div>
                    <div style="margin-bottom:2rem;">
                        <label>
                            <input type="checkbox" name="isDefault" value="true" checked /> Set as default address
                        </label>
                    </div>
                    <button type="submit" style="padding:12px 36px; background:#111; color:#fff; border:none; border-radius:30px; font-weight:700; cursor:pointer;">Save Address</button>
                    <button type="button" onclick="hideAddAddress()" style="background:none; border:none; color:#888; margin-left:15px; cursor:pointer;">Cancel</button>
                </form>
            </div>

            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
                    @foreach (var addr in Model.Addresses)
                    {
                        <div style="padding:1.5rem; border:1px solid @(addr.IsDefault ? "#111" : "#eee"); border-radius:16px; background:@(addr.IsDefault ? "#fff" : "#fafafa"); position:relative;">
                            @if (addr.IsDefault)
                            {
                                <span style="position:absolute; top:1rem; right:1.5rem; font-size:0.75rem; font-weight:700; color:var(--navy); text-transform:uppercase;">Default</span>
                            }
                            <p style="font-weight:700; margin:0 0 10px; font-size:1.1rem;">@addr.Label</p>
                            <p style="margin:0 0 5px; color:#555;">@addr.AddressLine</p>
                            <p style="margin:0 0 10px; color:#555;">@addr.City, @addr.ZipCode</p>
                            <p style="margin:0 0 15px; font-size:0.9rem; color:#888;">@addr.PhoneNumber</p>
                            
                            <div style="display:flex; gap:15px; align-items:center;">
                                @if (!addr.IsDefault)
                                {
                                    <form asp-controller="Account" asp-action="SetDefaultAddress" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="addressId" value="@addr.Id" />
                                        <button type="submit" style="background:none; border:none; color:#555; padding:0; cursor:pointer; font-size:0.85rem; text-decoration:underline;">Set as Default</button>
                                    </form>
                                }
                                <form asp-controller="Account" asp-action="DeleteAddress" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="addressId" value="@addr.Id" />
                                    <button type="submit" style="background:none; border:none; color:#ff4d4d; padding:0; cursor:pointer; font-size:0.85rem; text-decoration:underline;">Delete</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:#888; font-style:italic; padding-left:12px;">No addresses saved yet.</p>
            }
        </div>

        <hr style="border:none; border-top:1px solid #e0e0e0; margin:3rem 0;" />

        <!-- Security Section -->
        <div>
            <p style="font-size:clamp(1rem, 1.4vw, 1.2rem); font-weight:700; color:#111; margin:0 0 1.5rem; text-transform:uppercase; letter-spacing:0.05em;">Security</p>
            <div style="display:flex; justify-content:space-between; align-items:center; background:#f5f5f5; padding:1.5rem 2rem; border-radius:16px;">
                <div>
                    <p style="font-weight:700; margin-bottom:5px;">Password</p>
                    <p style="color:#666; margin:0;">********</p>
                </div>
                <a asp-controller="Account" asp-action="ResetPassword" asp-route-email="@Model.Email" style="padding:10px 24px; background:#fff; border:1px solid #111; border-radius:30px; color:#111; text-decoration:none; font-weight:700; font-size:0.85rem;">Change Password</a>
            </div>
        </div>

    </main>
</div>

<script>
    function showAddAddress() {
        document.getElementById('addAddressForm').style.display = 'block';
    }
    function hideAddAddress() {
        document.getElementById('addAddressForm').style.display = 'none';
    }
</script>
