@model Project_Hail_Mary.Models.Users
@{
    ViewData["Title"] = "My Profile";
}

<div style="display:flex; min-height:calc(100vh - 78px); max-width:860px; margin:0 auto; padding:2rem 1.5rem; gap:2rem;">

    <!-- Left nav -->
    <aside style="width:150px; flex-shrink:0; padding-top:0.5rem;">
        <a href="#" style="display:block; font-size:0.78rem; color:#111; text-decoration:none; padding:6px 0; border-bottom:1px solid #111; margin-bottom:8px; font-weight:500;">Account Overview</a>
        <a asp-controller="Account" asp-action="Orders" style="display:block; font-size:0.78rem; color:#555; text-decoration:none; padding:6px 0;">Orders</a>
    </aside>

    <!-- Divider -->
    <div style="width:1px; background:#e0e0e0; flex-shrink:0;"></div>

    <!-- Main content -->
    <main style="flex:1;">

        <!-- Avatar + greeting -->
        <div style="display:flex; align-items:center; gap:1.5rem; margin-bottom:1.5rem;">
            <div>
                <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="36" cy="36" r="35" stroke="#111" stroke-width="1.5" fill="none" />
                    <circle cx="36" cy="28" r="11" stroke="#111" stroke-width="1.5" fill="none" />
                    <path d="M10 62c0-14.36 11.64-26 26-26s26 11.64 26 26" stroke="#111" stroke-width="1.5" fill="none" stroke-linecap="round" />
                </svg>
                <a href="#" style="display:block; font-size:0.68rem; text-align:center; color:#111; margin-top:6px; text-decoration:underline; text-underline-offset:2px;">Edit Profile Picture</a>
            </div>
            <h1 style="font-size:2rem; font-weight:700; margin:0; color:#111;">Hi, @Model.FirstName!</h1>
        </div>

        <hr style="border:none; border-top:1px solid #e0e0e0; margin:0 0 1.5rem;" />

        <!-- Your Info -->
        <p style="font-size:0.82rem; font-weight:600; color:#111; margin:0 0 1rem;">Your Info</p>

        <div style="margin-bottom:1rem;">
            <p style="font-size:0.75rem; font-weight:600; color:#111; margin:0 0 3px;">Name</p>
            <p style="font-size:0.85rem; color:#444; margin:0; padding-left:8px;">@Model.FirstName @Model.LastName</p>
        </div>

        <div style="margin-bottom:1.8rem;">
            <p style="font-size:0.75rem; font-weight:600; color:#111; margin:0 0 3px;">Email</p>
            <p style="font-size:0.85rem; color:#444; margin:0; padding-left:8px;">@Model.Email</p>
        </div>

        <!-- Default Address -->
        <div style="margin-bottom:1.2rem;">
            <p style="font-size:0.82rem; font-weight:600; color:#111; margin:0 0 0.6rem;">Default Address</p>
            <p style="font-size:0.85rem; color:#444; margin:0 0 1rem; padding:8px 12px; background:#f7f7f7; border-radius:6px; display:inline-block;">
                @(Model.Address ?? "Philippines")
            </p>
        </div>

        <button style="padding:10px 28px; background:none; border:1.5px solid #111; border-radius:30px; font-size:0.68rem; letter-spacing:0.12em; text-transform:uppercase; font-weight:600; cursor:pointer; font-family:'DM Sans',sans-serif;">
            Change Default Address
        </button>

        <hr style="border:none; border-top:1px solid #e0e0e0; margin:2rem 0;" />

        <!-- Logout -->
        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" style="padding:10px 32px; background:none; border:1.5px solid #111; border-radius:30px; font-size:0.68rem; letter-spacing:0.12em; text-transform:uppercase; font-weight:600; cursor:pointer; font-family:'DM Sans',sans-serif;">
                Logout
            </button>
        </form>

    </main>
</div>