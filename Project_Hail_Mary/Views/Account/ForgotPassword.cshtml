@model Project_Hail_Mary.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">
    <!-- LEFT PANEL -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; border-radius:14px; object-fit:cover; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">
            <h1 class="form-title">Reset Password</h1>
            <p style="font-size:1.1rem; color:#555; margin-bottom:1.5rem;">
                Enter your email address and we'll send you a link to reset your password.
            </p>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <input asp-for="Email" class="bazar-input" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="text-center mb-3">
                    <button type="submit" class="bazar-btn">Send Link</button>
                </div>

                <div class="text-center">
                    <a asp-controller="Account" asp-action="Login" style="font-size:1rem; color:#111; font-weight:600; text-decoration:underline;">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}