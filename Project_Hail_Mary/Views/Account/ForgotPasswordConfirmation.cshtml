@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">
    <!-- LEFT PANEL -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; border-radius:14px; object-fit:cover; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card text-center">
            <h1 class="form-title">Check Your Email</h1>
            <p style="font-size:0.95rem; color:#555; margin-bottom:1.5rem;">
                If an account exists for <strong>@ViewBag.Email</strong>, we have sent a password reset link.
            </p>

            <div style="background-color: #f8f9fa; border: 1px dashed #ccc; padding: 2rem; border-radius: 8px; margin-bottom: 2rem;">
                <p class="small text-muted mb-2">[Simulation: This represents the email you would receive]</p>
                <a asp-controller="Account" asp-action="ResetPassword" asp-route-email="@ViewBag.Email" class="bazar-btn text-decoration-none d-inline-block">
                    Click Here to Reset Password
                </a>
            </div>

            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" style="font-size:0.82rem; color:#111; font-weight:600; text-decoration:underline;">Back to Login</a>
            </div>
        </div>
    </div>
</section>
