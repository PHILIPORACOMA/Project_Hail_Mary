@model List<Project_Hail_Mary.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div style="display:flex; min-height:calc(100vh - 78px); max-width:clamp(800px, 95vw, 1400px); margin:0 auto; padding:clamp(1rem, 5vw, 2.5rem) 1.5rem; gap:clamp(1rem, 3vw, 2.5rem); flex-wrap: wrap;">

    <!-- Left nav -->
    <aside style="width:clamp(150px, 18vw, 220px); flex-shrink:0; padding-top:0.5rem;">
        <a asp-controller="Account" asp-action="Profile" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#555; text-decoration:none; padding:6px 0; margin-bottom:8px;">Account Overview</a>
        <a href="#" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#111; text-decoration:none; padding:6px 0; border-bottom:1px solid #111; font-weight:500;">Orders</a>
    </aside>

    <!-- Divider -->
    <div style="width:1px; background:#e0e0e0; flex-shrink:0; align-self: stretch;"></div>

    <!-- Main content -->
    <main style="flex:1; min-width: 300px;">
        <h1 style="font-size:clamp(2rem, 5vw, 2.8rem); font-weight:700; margin:0 0 1.5rem; color:#111;">Orders</h1>

        @if (Model == null || !Model.Any())
        {
            <div style="padding:3rem 0; text-align:center; color:#888;">
                <p style="font-size:1.1rem;">You haven't placed any orders yet.</p>
                <a asp-controller="Shop" asp-action="Shop" style="font-size:1rem; color:#111; text-decoration:underline;">Start Shopping</a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div style="margin-bottom:2.5rem; border-bottom:1px solid #eee; padding-bottom:2rem;">
                    <!-- Delivery Info Header -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <p style="font-size:1rem; font-weight:700; color:#111; margin:0 0 8px; text-transform:uppercase; letter-spacing:0.05em;">Delivery Information</p>
                            <p style="font-size:1.1rem; color:#111; margin:0; line-height:1.4;">
                                @order.FullName <span style="color:#888; margin-left:4px;">@order.PhoneNumber</span><br />
                                @order.Address
                            </p>
                        </div>
                        <div style="text-align:right;">
                            <p style="font-size:0.95rem; font-weight:700; color:#111; margin:0;">
                                Expected Delivery: @order.OrderDate.AddDays(3).ToString("MMM d") - @order.OrderDate.AddDays(7).ToString("MMM d")
                            </p>
                            <p style="font-size:0.9rem; color:#888; margin:4px 0 0;">Status: <span style="color:#0d1b3e; font-weight:600;">@order.Status</span></p>
                        </div>
                    </div>

                    <!-- Order Items -->
                    @foreach (var item in order.Items)
                    {
                        <div style="display:flex; align-items:center; gap:clamp(1rem, 3vw, 2rem); background:#fff; border:1px solid #efefef; border-radius:12px; padding:clamp(10px, 2vw, 20px); margin-bottom:10px; flex-wrap: wrap;">
                            <div style="width:clamp(60px, 8vw, 100px); height:clamp(60px, 8vw, 100px); background:#f5f5f5; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden;">
                                <img src="/images/@(item.ProductSlug).png" alt="@item.ProductName" style="width:100%; height:100%; object-fit:contain;" onerror="this.src='/images/perfumes.jpg'" />
                            </div>
                            <div style="flex:1; min-width: 150px;">
                                <p style="font-size:clamp(1rem, 1.2vw, 1.2rem); font-weight:700; color:#111; margin:0 0 4px;">@item.ProductName</p>
                                <p style="font-size:0.95rem; color:#888; margin:0;">Size: @item.Size</p>
                            </div>
                            <div style="width:60px; text-align:center;">
                                <p style="font-size:1rem; color:#444; margin:0;">x@(item.Quantity)</p>
                            </div>
                            <div style="width:150px; text-align:right;">
                                <p style="font-size:clamp(1.1rem, 1.3vw, 1.3rem); font-weight:700; color:#111; margin:0;">₱@((item.Price * item.Quantity).ToString("N2"))</p>
                            </div>
                        </div>
                    }
                </div>
            }
        }

    </main>
</div>
