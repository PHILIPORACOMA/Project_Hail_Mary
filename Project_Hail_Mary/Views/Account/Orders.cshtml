@model List<Project_Hail_Mary.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div style="display:flex; min-height:calc(100vh - 78px); max-width:clamp(800px, 95vw, 1400px); margin:0 auto; padding:clamp(1rem, 5vw, 2.5rem) 1.5rem; gap:clamp(1rem, 3vw, 2.5rem); flex-wrap: wrap;">

    <!-- Left nav -->
    <aside style="width:clamp(150px, 18vw, 220px); flex-shrink:0; padding-top:0.5rem;">
        <a asp-controller="Account" asp-action="Profile" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#555; text-decoration:none; padding:6px 0; margin-bottom:8px;">Account Overview</a>
        <a href="#" style="display:block; font-size:clamp(0.9rem, 1.1vw, 1.1rem); color:#111; text-decoration:none; padding:6px 0; border-bottom:1px solid #111; font-weight:500;">Orders</a>
    </aside>

    <!-- Divider -->
    <div style="width:1px; background:#e0e0e0; flex-shrink:0; align-self: stretch;"></div>

    <!-- Main content -->
    <main style="flex:1; min-width: 300px;">
        <h1 style="font-size:clamp(2rem, 5vw, 2.8rem); font-weight:700; margin:0 0 1.5rem; color:#111;">Orders</h1>

        @if (Model == null || !Model.Any())
        {
            <div style="padding:3rem 0; text-align:center; color:#888;">
                <p style="font-size:1.1rem;">You haven't placed any orders yet.</p>
                <a asp-controller="Shop" asp-action="Shop" style="font-size:1rem; color:#111; text-decoration:underline;">Start Shopping</a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div style="margin-bottom:3rem; background:#fff; border:1px solid #eee; border-radius:16px; padding:2rem; overflow:hidden;">
                    <!-- Order Header -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem; flex-wrap: wrap; gap: 1rem;">
                        <div>
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Order ID</p>
                            <p style="font-size:1.1rem; font-weight:700; color:#111; margin:0;">#@order.Id.ToString("D5")</p>
                        </div>
                        <div>
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Date</p>
                            <p style="font-size:1.1rem; color:#111; margin:0;">@order.OrderDate.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div>
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Status</p>
                            <span style="display:inline-block; padding:4px 12px; background:#e8f4fd; color:#0d1b3e; border-radius:20px; font-size:0.85rem; font-weight:700; text-transform:uppercase;">@order.Status</span>
                        </div>
                        <div style="text-align:right;">
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:5px;">Total</p>
                            <p style="font-size:1.1rem; font-weight:700; color:var(--navy); margin:0;">₱@order.TotalAmount.ToString("N2")</p>
                        </div>
                    </div>

                    <hr style="border:none; border-top:1px solid #eee; margin:1.5rem 0;" />

                    <!-- Delivery & Tracking Section -->
                    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:2rem; margin-bottom:2rem;">
                        <div>
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:10px;">Delivery Information</p>
                            <p style="font-size:1rem; color:#111; margin:0 0 5px; font-weight:600;">@order.FullName</p>
                            <p style="font-size:1rem; color:#555; margin:0 0 5px; line-height:1.4;">@order.Address</p>
                            <p style="font-size:1rem; color:#555; margin:0;">@order.PhoneNumber</p>
                        </div>
                        <div>
                            <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:10px;">Shipping & Tracking</p>
                            @if (!string.IsNullOrEmpty(order.TrackingNumber))
                            {
                                <div style="background:#f9f9f9; padding:1.2rem; border-radius:12px; border:1px dashed #ccc;">
                                    <p style="font-size:0.85rem; color:#666; margin-bottom:5px;">Tracking Number:</p>
                                    <p style="font-size:1.1rem; font-weight:700; color:#111; margin:0 0 10px;">@order.TrackingNumber</p>
                                    <button type="button" class="bazar-btn" style="padding:8px 20px; font-size:0.75rem; background:#111;" onclick="alert('Tracking ID: @order.TrackingNumber\nStatus: In Transit\nCarrier: Bəzár Express')">Track Order</button>
                                </div>
                            }
                            else
                            {
                                <p style="font-size:0.95rem; color:#888; font-style:italic;">Tracking will be available once the order is shipped.</p>
                            }
                        </div>
                    </div>

                    <!-- Order Items -->
                    <p style="font-size:0.85rem; font-weight:700; color:#888; text-transform:uppercase; margin-bottom:15px;">Items Ordered</p>
                    <div style="display:flex; flex-direction:column; gap:12px;">
                        @foreach (var item in order.Items)
                        {
                            <div style="display:flex; align-items:center; gap:1.5rem; background:#fafafa; border-radius:12px; padding:12px 20px;">
                                <div style="width:50px; height:65px; background:#fff; border-radius:6px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; border:1px solid #eee;">
                                    <img src="/images/@(item.ProductSlug).png" alt="@item.ProductName" style="width:100%; height:100%; object-fit:contain;" onerror="this.src='/images/perfumes.jpg'" />
                                </div>
                                <div style="flex:1;">
                                    <p style="font-size:1rem; font-weight:700; color:#111; margin:0 0 2px;">@item.ProductName</p>
                                    <p style="font-size:0.85rem; color:#888; margin:0;">Size: @item.Size | Qty: @item.Quantity</p>
                                </div>
                                <div style="text-align:right;">
                                    <p style="font-size:1rem; font-weight:700; color:#111; margin:0;">₱@((item.Price * item.Quantity).ToString("N2"))</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }

    </main>
</div>
