@model List<Project_Hail_Mary.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div style="display:flex; min-height:calc(100vh - 78px); max-width:860px; margin:0 auto; padding:2rem 1.5rem; gap:2rem;">

    <!-- Left nav -->
    <aside style="width:150px; flex-shrink:0; padding-top:0.5rem;">
        <a asp-controller="Account" asp-action="Profile" style="display:block; font-size:0.78rem; color:#555; text-decoration:none; padding:6px 0; margin-bottom:8px;">Account Overview</a>
        <a href="#" style="display:block; font-size:0.78rem; color:#111; text-decoration:none; padding:6px 0; border-bottom:1px solid #111; font-weight:500;">Orders</a>
    </aside>

    <!-- Divider -->
    <div style="width:1px; background:#e0e0e0; flex-shrink:0;"></div>

    <!-- Main content -->
    <main style="flex:1;">
        <h1 style="font-size:2rem; font-weight:700; margin:0 0 1.5rem; color:#111;">Orders</h1>

        @if (Model == null || !Model.Any())
        {
            <div style="padding:3rem 0; text-align:center; color:#888;">
                <p style="font-size:0.9rem;">You haven't placed any orders yet.</p>
                <a asp-controller="Shop" asp-action="Shop" style="font-size:0.75rem; color:#111; text-decoration:underline;">Start Shopping</a>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div style="margin-bottom:2.5rem; border-bottom:1px solid #eee; padding-bottom:2rem;">
                    <!-- Delivery Info Header -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem;">
                        <div>
                            <p style="font-size:0.75rem; font-weight:700; color:#111; margin:0 0 8px; text-transform:uppercase; letter-spacing:0.05em;">Delivery Information</p>
                            <p style="font-size:0.8rem; color:#111; margin:0; line-height:1.4;">
                                @order.FullName <span style="color:#888; margin-left:4px;">@order.PhoneNumber</span><br />
                                @order.Address
                            </p>
                        </div>
                        <div style="text-align:right;">
                            <p style="font-size:0.75rem; font-weight:700; color:#111; margin:0;">
                                Expected Delivery: @order.OrderDate.AddDays(3).ToString("MMM d") - @order.OrderDate.AddDays(7).ToString("MMM d")
                            </p>
                        </div>
                    </div>

                    <!-- Order Items -->
                    @foreach (var item in order.Items)
                    {
                        <div style="display:flex; align-items:center; gap:1.2rem; background:#fff; border:1px solid #efefef; border-radius:12px; padding:12px; margin-bottom:10px;">
                            <div style="width:60px; height:60px; background:#f5f5f5; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden;">
                                <img src="/images/@(item.ProductSlug).jpeg" alt="@item.ProductName" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/images/perfumes.jpg'" />
                            </div>
                            <div style="flex:1;">
                                <p style="font-size:0.85rem; font-weight:700; color:#111; margin:0 0 2px;">@item.ProductName</p>
                                <p style="font-size:0.75rem; color:#888; margin:0;">@item.Size</p>
                            </div>
                            <div style="width:60px; text-align:center;">
                                <p style="font-size:0.8rem; color:#444; margin:0;">x@item.Quantity</p>
                            </div>
                            <div style="width:100px; text-align:right;">
                                <p style="font-size:0.85rem; font-weight:700; color:#111; margin:0;">Total: ₱@((item.Price * item.Quantity).ToString("N2"))</p>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- Logout -->
        <div style="margin-top:2rem;">
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit"
                        style="padding:10px 32px; background:none; border:1.5px solid #111;
                               border-radius:30px; font-size:0.68rem; letter-spacing:0.12em;
                               text-transform:uppercase; font-weight:600; cursor:pointer;
                               font-family:'DM Sans',sans-serif;">
                    Logout
                </button>
            </form>
        </div>

    </main>
</div>
