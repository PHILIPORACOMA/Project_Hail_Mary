@model Project_Hail_Mary.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">
    <!-- LEFT PANEL -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; border-radius:14px; object-fit:cover; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">
            <h1 class="form-title">New Password</h1>
            <p style="font-size:1.1rem; color:#555; margin-bottom:1.5rem;">
                Please enter and confirm your new password below.
            </p>

            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <input asp-for="NewPassword" class="bazar-input" placeholder="New Password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <input asp-for="ConfirmPassword" class="bazar-input" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="text-center mb-3">
                    <button type="submit" class="bazar-btn w-100">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}