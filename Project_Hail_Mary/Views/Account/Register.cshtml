@model Project_Hail_Mary.Models.Users
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">

    <!-- LEFT PANEL — brand card (replace inner content with your logo image if you have one) -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; border-radius:14px; object-fit:cover; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">

            <h1 class="form-title">Create Account</h1>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <input asp-for="FirstName" class="bazar-input" placeholder="First Name" />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="LastName" class="bazar-input" placeholder="Last Name" />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="Email" class="bazar-input" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <input asp-for="Password" class="bazar-input" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <input asp-for="ConfirmPassword" class="bazar-input" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="text-center mb-3">
                    <button type="submit" class="bazar-btn">Register</button>
                </div>

                <div class="text-center">
                    <p style="font-size:0.82rem; color:#777; margin:0;">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" style="color:#111; font-weight:600; text-decoration:underline;">Sign in!</a>
                    </p>
                </div>

            </form>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}