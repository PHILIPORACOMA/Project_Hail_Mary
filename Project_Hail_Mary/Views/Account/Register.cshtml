@model Project_Hail_Mary.Models.Users
@{
    ViewData["Title"] = "Register";
}

<h1>Register</h1>

<form asp-controller="Account" asp-action="Register" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <input asp-for="Email" class="form-control form-control-bazar" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input asp-for="Password" class="form-control form-control-bazar" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-4">
        <input asp-for="ConfirmPassword" class="form-control form-control-bazar" placeholder="Confirm Password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-flex flex-column align-items-center gap-3">
        <button type="submit" class="btn btn-register px-5">Register</button>
        <p class="signin-link mb-0">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Sign in!</a>
        </p>
    </div>
</form>