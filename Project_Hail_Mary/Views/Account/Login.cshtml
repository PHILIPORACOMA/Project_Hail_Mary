@model Project_Hail_Mary.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">

    <!-- LEFT PANEL — paste your perfume image here as an <img> tag -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; height:100%; border-radius:14px; object-fit:cover; object-position: center; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">

            <h1 class="form-title">Login</h1>

            @if (TempData["ResetSuccess"] != null)
            {
                <div class="alert alert-success text-center small mb-3">
                    @TempData["ResetSuccess"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <input asp-for="Email" class="bazar-input" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <input asp-for="Password" class="bazar-input" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="text-center mb-4">
                    <button type="submit" class="bazar-btn w-100 mb-3">Sign In</button>

                    <div style="display:flex; align-items:center; margin: 1.5rem 0; color:#ccc;">
                        <hr style="flex:1; border-color:#eee;" />
                        <span style="padding:0 15px; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.1em; color:#999;">Or continue with</span>
                        <hr style="flex:1; border-color:#eee;" />
                    </div>

                    <a asp-controller="Account" asp-action="GoogleLogin" style="display:flex; align-items:center; justify-content:center; gap:12px; padding:12px; border:1px solid #ddd; border-radius:30px; color:#333; text-decoration:none; font-weight:600; font-size:0.95rem; transition: background 0.2s;">
                        <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083A19.954 19.954 0 0 1 44 24c0 5.759-2.235 10.983-5.88 14.862l-6.131-5.186A12.014 12.014 0 0 0 36 24c0-.685-.06-1.354-.174-2.003L43.611 20.083z"/></svg>
                        Google
                    </a>
                </div>

                <div class="text-center">
                    <a asp-controller="Account" asp-action="ForgotPassword" style="display:block; font-size:1rem; color:#555; text-decoration:underline; margin-bottom:8px;">
                        Forgot your password?
                    </a>
                    <p style="font-size:1rem; color:#777; margin:0;">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" style="color:#111; font-weight:600; text-decoration:underline;">Sign up!</a>
                    </p>
                </div>

            </form>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}   