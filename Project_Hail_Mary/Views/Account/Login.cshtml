@model Project_Hail_Mary.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="account-section">

    <!-- LEFT PANEL — paste your perfume image here as an <img> tag -->
    <div class="left-panel">
        <img src="~/images/bazarlogo.jpg" alt="bazarlogo"
             style="width:100%; height:100%; border-radius:14px; object-fit:cover; object-position: center; display:block;" />
    </div>

    <!-- RIGHT PANEL -->
    <div class="right-panel">
        <div class="form-card">

            <h1 class="form-title">Login</h1>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <input asp-for="Email" class="bazar-input" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <input asp-for="Password" class="bazar-input" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="text-center mb-3">
                    <button type="submit" class="bazar-btn">Sign In</button>
                </div>

                <div class="text-center">
                    <a asp-controller="Account" asp-action="ForgotPassword" style="display:block; font-size:0.82rem; color:#555; text-decoration:underline; margin-bottom:6px;">
                        Forgot your password?
                    </a>
                    <p style="font-size:0.82rem; color:#777; margin:0;">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" style="color:#111; font-weight:600; text-decoration:underline;">Sign up!</a>
                    </p>
                </div>

            </form>
        </div>
    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}   