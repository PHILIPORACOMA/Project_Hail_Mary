@{
    ViewData["Title"] = "Shop";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d1b3e;
            --navy-mid: #1a2f6e;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        /* NAV */
        .navbar-bazar {
            background-color: var(--navy);
            padding: 0 2rem;
            height: 62px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .navbar-bazar .nav-link {
                color: #c8d3e8 !important;
                font-size: 0.7rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 0.35rem 0.6rem !important;
                transition: color 0.2s;
            }

                .navbar-bazar .nav-link:hover {
                    color: #fff !important;
                }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.55rem;
            letter-spacing: 0.04em;
            line-height: 1;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 0.52rem;
            letter-spacing: 0.3em;
            color: #8a9ab8;
            text-transform: uppercase;
            text-align: center;
            display: block;
            margin-top: 2px;
        }

        /* SHOP BANNER */
        .shop-banner {
            position: relative;
            height: 180px;
            overflow: hidden;
            background: linear-gradient(120deg, #0b1838 0%, #162255 50%, #1c3070 100%);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding-bottom: 1.5rem;
        }

            .shop-banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 100% 80% at 50% 0%, rgba(30,60,140,0.6) 0%, transparent 70%), repeating-linear-gradient(118deg, transparent 0px, rgba(255,255,255,0.02) 1px, transparent 2px, transparent 60px), repeating-linear-gradient(62deg, transparent 0px, rgba(255,255,255,0.015) 1px, transparent 2px, transparent 80px);
                pointer-events: none;
            }

        /* FILTER TABS */
        .filter-bar {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            padding: 1.6rem 0 0.5rem;
        }

        .filter-btn {
            background: transparent;
            border: 1px solid #ccc;
            border-radius: 50px;
            padding: 0.4rem 1.4rem;
            font-size: 0.68rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #555;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
        }

            .filter-btn:hover, .filter-btn.active {
                background: var(--navy);
                border-color: var(--navy);
                color: #fff;
            }

        /* PRODUCT COUNT */
        .product-count {
            text-align: right;
            font-size: 0.78rem;
            color: #999;
            padding: 0.5rem 0 1.2rem;
            letter-spacing: 0.04em;
        }

        /* PRODUCT GRID */
        .shop-section {
            padding: 0 0 5rem;
        }

        .product-card-shop {
            background: #f8f8f8;
            border-radius: 6px;
            padding: 2rem 1rem 1.4rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.22s, box-shadow 0.22s;
        }

            .product-card-shop:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.07);
            }

        .product-img-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 0.9rem;
            min-height: 110px;
            align-items: flex-end;
        }

        .product-name-shop {
            font-size: 0.75rem;
            color: #333;
            text-align: center;
            margin: 0;
            letter-spacing: 0.04em;
        }

        /* Placeholder bottle colors for variety */
        .bottle-a {
            fill: #1e3580;
        }

        .bottle-b {
            fill: #162255;
        }

        .bottle-c {
            fill: #243e8a;
        }
    </style>
</head>
<body>

  
    <!-- SHOP BANNER -->
    <div class="shop-banner"></div>

    <!-- FILTER BAR -->
    <div class="container">
        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterProducts(this,'all')">Featured</button>
            <button class="filter-btn" onclick="filterProducts(this,'women')">Women</button>
            <button class="filter-btn" onclick="filterProducts(this,'men')">Men</button>
        </div>
        <div class="product-count" id="productCount">14 products</div>
    </div>

    <!-- PRODUCT GRID -->
    <section class="shop-section">
        <div class="container">
            <div class="row g-3" id="productGrid">
                @{
                    var products = new[] {
                                new { Name = "Afro",    Slug = "afro",    Category = "men"   },
                                new { Name = "Crest",   Slug = "crest",   Category = "women" },
                                new { Name = "Florine", Slug = "florine", Category = "women" },
                                new { Name = "Quiff",   Slug = "quiff",   Category = "men"   },
                                new { Name = "Enchantè",Slug = "enchante",Category = "women" },
                                new { Name = "Baco",    Slug = "baco",    Category = "men"   },
                                new { Name = "Antheia", Slug = "antheia", Category = "women" },
                                new { Name = "Hypnos",  Slug = "hypnos",  Category = "men"   },
                                new { Name = "Temple",  Slug = "temple",  Category = "men"   },
                                new { Name = "Athena",  Slug = "athena",  Category = "women" },
                                new { Name = "Muller",  Slug = "muller",  Category = "men"   },
                                new { Name = "Slick",   Slug = "slick",   Category = "men"   },
                                new { Name = "Aphroe",  Slug = "aphroe",  Category = "women" },
                                new { Name = "Toper",   Slug = "toper",   Category = "men"   },
                                };
                    int idx = 0;
                    string[] shades = { "#1e3580", "#162255", "#243e8a", "#1a2f6e", "#0f2260", "#1b3878" };
                }
                @foreach (var p in products)
                {
                    string color = shades[idx % shades.Length];
                    idx++;
                    <div class="col-6 col-sm-4 col-md-3 product-item" data-category="@p.Category">
                        <div class="product-card-shop">
                            <div class="product-img-wrap">
                                @*
                                    Replace the SVG below with a real image once available:
                                    <img src="~/images/products/@(p.Slug).png" alt="@p.Name" style="max-height:110px;object-fit:contain;" />
                                *@
                                <svg width="70" height="110" viewBox="0 0 70 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="24" y="0" width="22" height="10" rx="2.5" fill="@(color)" opacity="0.7" />
                                    <rect x="27" y="9" width="16" height="16" rx="2" fill="@(color)" opacity="0.85" />
                                    <rect x="6" y="23" width="58" height="84" rx="8" fill="@(color)" />
                                    <rect x="6" y="23" width="58" height="84" rx="8" fill="url(#sp_@(p.Slug))" />
                                    <rect x="13" y="52" width="44" height="32" rx="3.5" fill="rgba(255,255,255,0.1)" />
                                    <text x="35" y="71" text-anchor="middle" fill="rgba(255,255,255,0.65)" font-size="5.5" font-family="Georgia,serif" letter-spacing="0.5">@p.Name.ToLower()</text>
                                    <defs>
                                        <linearGradient id="sp_@(p.Slug)" x1="6" y1="23" x2="64" y2="107" gradientUnits="userSpaceOnUse">
                                            <stop offset="0%" stop-color="white" stop-opacity="0.18" />
                                            <stop offset="100%" stop-color="black" stop-opacity="0.2" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                            </div>
                            <p class="product-name-shop">@p.Name</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filterProducts(btn, category) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const items = document.querySelectorAll('.product-item');
            let count = 0;
            items.forEach(item => {
                const match = category === 'all' || item.dataset.category === category;
                item.style.display = match ? '' : 'none';
                if (match) count++;
            });
            document.getElementById('productCount').textContent = count + ' product' + (count !== 1 ? 's' : '');
        }
    </script>
</body>
</html>