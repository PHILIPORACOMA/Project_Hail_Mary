@{
    ViewData["Title"] = "Shop";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d1b3e;
            --navy-mid: #1a2f6e;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #fff;
            margin: 0;
            overflow-x: hidden;
        }

        /* NAV */
        .navbar-bazar {
            background-color: var(--navy);
            padding: 0 2rem;
            height: 62px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

            .navbar-bazar .nav-link {
                color: #c8d3e8 !important;
                font-size: 0.7rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                font-weight: 500;
                padding: 0.35rem 0.6rem !important;
                transition: color 0.2s;
            }

                .navbar-bazar .nav-link:hover {
                    color: #fff !important;
                }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.55rem;
            letter-spacing: 0.04em;
            line-height: 1;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 0.52rem;
            letter-spacing: 0.3em;
            color: #8a9ab8;
            text-transform: uppercase;
            text-align: center;
            display: block;
            margin-top: 2px;
        }

        /* SHOP BANNER */
        .shop-banner {
            position: relative;
            height: 180px;
            overflow: hidden;
            background: linear-gradient(120deg, #0b1838 0%, #162255 50%, #1c3070 100%);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding-bottom: 1.5rem;
        }

            .shop-banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 100% 80% at 50% 0%, rgba(30,60,140,0.6) 0%, transparent 70%), repeating-linear-gradient(118deg, transparent 0px, rgba(255,255,255,0.02) 1px, transparent 2px, transparent 60px), repeating-linear-gradient(62deg, transparent 0px, rgba(255,255,255,0.015) 1px, transparent 2px, transparent 80px);
                pointer-events: none;
            }

        /* FILTER TABS */
        .filter-bar {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            padding: 1.6rem 0 0.5rem;
        }

        .filter-btn {
            background: transparent;
            border: 1px solid #ccc;
            border-radius: 50px;
            padding: 0.4rem 1.4rem;
            font-size: clamp(0.6rem, 1vw, 0.68rem);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #555;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
        }

            .filter-btn:hover, .filter-btn.active {
                background: var(--navy);
                border-color: var(--navy);
                color: #fff;
            }

        /* PRODUCT COUNT */
        .product-count {
            text-align: right;
            font-size: clamp(0.65rem, 1.2vw, 0.78rem);
            color: #999;
            padding: 0.5rem 0 1.2rem;
            letter-spacing: 0.04em;
        }

        /* PRODUCT GRID */
        .shop-section {
            padding: 0 0 5rem;
        }

        /* ── UPDATED: product card is now an anchor ── */
        .product-card-shop {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: #f8f8f8;
            border-radius: 6px;
            padding: 2rem 1rem 1.4rem;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            transition: transform 0.22s, box-shadow 0.22s;
        }

            .product-card-shop:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.07);
                color: inherit;
                text-decoration: none;
            }

        .product-img-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 0.9rem;
            height: clamp(150px, 20vh, 220px);
            align-items: center;
        }

        .product-name-shop {
            font-size: clamp(0.65rem, 1.2vw, 0.75rem);
            color: #333;
            text-align: center;
            margin: 0;
            letter-spacing: 0.04em;
        }
    </style>
</head>
<body>

  

  

    <!-- FILTER BAR -->
    <div class="container-fluid" style="padding: 0 clamp(2rem, 5vw, 6rem);">
        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterProducts(this,'all')">Featured</button>
            <button class="filter-btn" onclick="filterProducts(this,'women')">Women</button>
            <button class="filter-btn" onclick="filterProducts(this,'men')">Men</button>
        </div>
        <div class="product-count" id="productCount">14 products</div>
    </div>

    <!-- PRODUCT GRID -->
    <section class="shop-section">
        <div class="container-fluid" style="padding: 0 clamp(2rem, 5vw, 6rem);">
            <div class="row g-4" id="productGrid">
                @{
                    var products = new[] {
                                new { Name = "Afro",     Slug = "afro",     Category = "men"   },
                                new { Name = "Cloud",    Slug = "cloud",    Category = "women" },
                                new { Name = "Florise",  Slug = "florise",  Category = "women" },
                                new { Name = "Quiff",    Slug = "quiff",    Category = "men"   },
                                new { Name = "Enchantè", Slug = "enchante", Category = "women" },
                                new { Name = "Buzz",     Slug = "buzz",     Category = "men"   },
                                new { Name = "Antheia",  Slug = "antheia",  Category = "women" },
                                new { Name = "Hygea",   Slug = "hygea",   Category = "women"   },
                                new { Name = "Temple",   Slug = "temple",   Category = "men"   },
                                new { Name = "Athena",   Slug = "athena",   Category = "women" },
                                new { Name = "Mullet",   Slug = "mullet",   Category = "men"   },
                                new { Name = "Slick",    Slug = "slick",    Category = "men"   },
                                new { Name = "Aphrora",   Slug = "aphrora",   Category = "women" },
                                new { Name = "Taper",    Slug = "taper",    Category = "men"   },
                                };
                    int idx = 0;
                    string[] shades = { "#1e3580", "#162255", "#243e8a", "#1a2f6e", "#0f2260", "#1b3878" };
                }
                @foreach (var p in products)
                {
                    string color = shades[idx % shades.Length];
                    idx++;
                    <div class="col-6 col-sm-4 col-md-3 product-item" data-category="@p.Category">
                        <!-- Changed from div to anchor tag pointing to ProductDetail -->
                        <a class="product-card-shop"
                           href="/Shop/ProductDetail?slug=@p.Slug&name=@Uri.EscapeDataString(p.Name)&category=@p.Category">
                            <div class="product-img-wrap">
                                @*
                                    Replace the SVG below with a real image once available:
                                    <img src="~/images/products/@(p.Slug).png" alt="@p.Name" style="max-height:110px;object-fit:contain;" />
                                *@
                                <img src="/images/@(p.Slug).png" alt="@p.Name"
                                     style="max-height:clamp(150px, 30vh, 250px); max-width:100%; object-fit:contain;"
                                     onerror="this.style.opacity='0'" />
                            </div>
                            <p class="product-name-shop">@p.Name</p>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filterProducts(btn, category) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const items = document.querySelectorAll('.product-item');
            let count = 0;
            items.forEach(item => {
                const match = category === 'all' || item.dataset.category === category;
                item.style.display = match ? '' : 'none';
                if (match) count++;
            });
            document.getElementById('productCount').textContent = count + ' product' + (count !== 1 ? 's' : '');
        }
    </script>
</body>
</html>
