@model Project_Hail_Mary.Models.Users
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - b?zár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d1b3e;
            --input-bg: #eeeeee;
            --text-dark: #111;
            --text-muted: #888;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: #fff;
            margin: 0;
        }

        .navbar-bazar {
            background-color: var(--navy);
            padding: 0 2rem;
            height: 90px;
        }

        .navbar-bazar .nav-link {
            color: #d0d8e8 !important;
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 500;
            }

                .navbar-bazar .nav-link:hover {
                    color: #fff !important;
                }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.6rem;
            letter-spacing: 0.04em;
            line-height: 1.1;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 0.6rem;
            letter-spacing: 0.25em;
            color: #aab4c8;
            text-transform: uppercase;
            text-align: center;
            display: block;
        }

        .login-section {
            min-height: calc(100vh - 90px);
            display: flex;
            align-items: center;
            padding: 3rem 1rem;
        }

        .brand-card {
            background: linear-gradient(145deg, #1a2f6e 0%, #0d1b3e 60%, #162040 100%);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 400px;
            padding: 3rem 2rem;
        }

            .brand-card img {
                max-width: 100%;
                height: auto;
                object-fit: cover;
                border-radius: 8px;
            }

        .form-area {
            padding: 0 1rem 0 2.5rem;
        }

            .form-area h1 {
                font-family: 'Playfair Display', serif;
                font-size: 2.6rem;
                font-weight: 700;
                color: var(--text-dark);
                margin-bottom: 2rem;
            }

        .form-control-bazar {
            background-color: var(--input-bg);
            border: none;
            border-radius: 8px;
            padding: 0.85rem 1.1rem;
            font-size: 0.88rem;
            color: #333;
            transition: background 0.2s, box-shadow 0.2s;
        }

            .form-control-bazar::placeholder {
                color: #999;
            }

            .form-control-bazar:focus {
                background-color: #e6e6e6;
                box-shadow: 0 0 0 3px rgba(13,27,62,0.12);
                outline: none;
                border-color: transparent;
            }

        .btn-login {
            background-color: var(--navy);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 0.75rem 2.5rem;
            font-size: 0.8rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-weight: 600;
            transition: background 0.2s, transform 0.15s;
        }

            .btn-login:hover {
                background-color: #1a2f6e;
                color: #fff;
                transform: translateY(-1px);
            }

        .register-link {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

            .register-link a {
                color: var(--text-dark);
                font-weight: 500;
                text-decoration: underline;
            }

        .text-danger {
            font-size: 0.78rem;
        }

        .forgot-password {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

            .forgot-password a {
                color: var(--text-dark);
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-bazar">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <ul class="nav d-flex gap-3">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
            </ul>
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <div class="brand-title">b?zár</div>
                <span class="brand-subtitle">Bizarre</span>
            </a>
            <ul class="nav d-flex gap-3">
                <li class="nav-item"><a class="nav-link" href="#">Search</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Account</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Cart (0)</a></li>
            </ul>
        </div>
    </nav>

    <!-- LOGIN SECTION -->
    <section class="login-section">
        <div class="container">
            <div class="row align-items-center g-4">

                <!-- Brand Card with Image -->
                <div class="col-lg-5 col-md-5">
                    <div class="brand-card">
                        <!-- IMAGE PLACEHOLDER: Place wwwroot/images/perfume-display.png here (4 perfume bottles) -->
                        <img src="~/images/perfume-display.png" alt="Perfume Collection" style="max-width: 280px; height: auto;" />
                    </div>
                </div>

                <!-- Form -->
                <div class="col-lg-7 col-md-7">
                    <div class="form-area">
                        <h1>Sign In</h1>

                        <form asp-controller="Account" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <input asp-for="Email" type="email" class="form-control form-control-bazar" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <input asp-for="Password" type="password" class="form-control form-control-bazar" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="d-flex flex-column align-items-center gap-3">
                                <button type="submit" class="btn btn-login px-5">Sign In</button>
                                <p class="forgot-password mb-2">
                                    <a href="#">Forgot your password?</a>
                                </p>
                                <p class="register-link mb-0">
                                    Don't have an account?
                                    <a asp-controller="Account" asp-action="Register">Register</a>
                                </p>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>