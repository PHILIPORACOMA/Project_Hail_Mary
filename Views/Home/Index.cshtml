@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - bəzár</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d1b3e;
            --text-dark: #111;
            --text-white: #fff;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: #fff;
            margin: 0;
        }

        .navbar-bazar {
            background-color: var(--navy);
            padding: 0 2rem;
            height: 90px;
        }

        .navbar-bazar .nav-link {
            color: #d0d8e8 !important;
            font-size: 0.75rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .navbar-bazar .nav-link:hover {
            color: var(--text-white) !important;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: var(--text-white);
            font-size: 1.6rem;
            letter-spacing: 0.04em;
            line-height: 1.1;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 0.6rem;
            letter-spacing: 0.25em;
            color: #aab4c8;
            text-transform: uppercase;
            text-align: center;
            display: block;
        }

        .hero-section {
            background: linear-gradient(135deg, rgba(13, 27, 62, 0.85) 0%, rgba(26, 47, 110, 0.85) 100%),
                        url('~/images/hero-background.jpg') center/cover;
            min-height: 600px;
            display: flex;
            align-items: center;
            padding: 4rem 2rem;
            border-radius: 16px;
            margin: 3rem;
            position: relative;
            overflow: hidden;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--text-white);
            line-height: 1.2;
            margin-bottom: 2rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .btn-shop {
            background-color: transparent;
            color: var(--text-white);
            border: 2px solid var(--text-white);
            border-radius: 50px;
            padding: 0.9rem 2rem;
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
            text-decoration: none;
        }

        .btn-shop:hover {
            background-color: var(--text-white);
            color: var(--navy);
        }

        .hero-image {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: center;
        }

        .hero-image img {
            max-width: 100%;
            height: auto;
        }

        @media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2.2rem;
            }

            .hero-section {
                min-height: 450px;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-bazar">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <ul class="nav d-flex gap-3">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Shop</a></li>
                <li class="nav-item"><a class="nav-link" href="#">About</a></li>
            </ul>
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <div class="brand-title">bəzár</div>
                <span class="brand-subtitle">Bizarre</span>
            </a>
            <ul class="nav d-flex gap-3">
                <li class="nav-item"><a class="nav-link" href="#">Search</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Account</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Cart (0)</a></li>
            </ul>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <h1>Skip the ordinary.<br />Wear the<br />unexpected.</h1>
                        <a asp-controller="Shop" asp-action="Index" class="btn-shop">Shop the collection</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image">
                        <img src="~/images/hero-products.png" alt="Featured Perfume Collection" style="max-width: 100%; height: auto;" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>